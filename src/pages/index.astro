---
import '@fontsource-variable/figtree/wght.css';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Solutions from '../components/Solutions.astro';
import CreditCardPromo from '../components/CreditCardPromo.astro';
import Trust from '../components/Trust.astro';
import LeadForm from '../components/LeadForm.astro';
import Footer from '../components/Footer.astro';
import HomeMotion from '../components/HomeMotion.astro';
import logoMark from '../assets/home/logo-mark.svg';
import '../styles/global.css';

const title = 'Lobo Kapital | Financiamiento inteligente';
const description = 'Créditos, arrendamiento y soluciones financieras diseñadas para impulsar tu patrimonio y tu negocio.';
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#c10230" />
		<link rel="icon" type="image/svg+xml" href={logoMark.src} />
		<title>{title}</title>
		<ClientRouter />
	</head>
	<body data-page="home">
		<a class="skip-link" href="#main-content">Saltar al contenido principal</a>
		<Header />
		<main id="main-content" tabindex="-1" transition:name="page-main" transition:animate="fade">
			<Hero />
			<Solutions />
			<CreditCardPromo />
			<Trust />
			<LeadForm />
		</main>
		<Footer />
		<HomeMotion />
	</body>
</html>
