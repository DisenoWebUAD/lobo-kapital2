---
import '@fontsource-variable/figtree/wght.css';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PymesHero from '../components/PymesHero.astro';
import CreditDetails from '../components/CreditDetails.astro';
import LoanRequirements from '../components/LoanRequirements.astro';
import LoanConditions from '../components/LoanConditions.astro';
import LoanCalculator from '../components/LoanCalculator.astro';
import PymesSolutions from '../components/PymesSolutions.astro';
import LeadForm from '../components/LeadForm.astro';
import logoMark from '../assets/home/logo-mark.svg';
import '../styles/global.css';
import '../styles/pymes-credit.css';

const title = 'Créditos PyMEs | Lobo Kapital';
const description = 'Financiamiento estratégico para impulsar el crecimiento de tu pequeña o mediana empresa.';
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#c10230" />
		<link rel="icon" type="image/svg+xml" href={logoMark.src} />
		<title>{title}</title>
		<ClientRouter />
	</head>
	<body class="pymes-credit-page">
		<a class="skip-link" href="#main-content">Saltar al contenido principal</a>
		<Header />
		<main id="main-content" tabindex="-1" transition:name="page-main" transition:animate="fade">
			<PymesHero />
			<CreditDetails product="business">
				<LoanRequirements slot="heading" product="business" />
				<LoanConditions slot="conditions" product="business" />
			</CreditDetails>
			<LoanCalculator product="business" />
			<PymesSolutions />
			<LeadForm product="business" sectionId="solicitud" />
		</main>
		<Footer />
	</body>
</html>
