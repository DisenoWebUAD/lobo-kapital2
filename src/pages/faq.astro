---
import '@fontsource-variable/figtree/wght.css';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { faqs } from '../data/faqs';
import faqIcon from '../assets/faq-icon.svg';
import logoMark from '../assets/home/logo-mark.svg';
import '../styles/global.css';
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content="Resuelve tus dudas sobre Lobo Kapital, los requisitos del crédito personal y empresarial, las simulaciones y el proceso de solicitud." />
		<meta name="theme-color" content="#c10230" />
		<link rel="icon" type="image/svg+xml" href={logoMark.src} />
		<title>Preguntas frecuentes | Lobo Kapital</title>
		<ClientRouter />
	</head>
	<body>
		<a class="skip-link" href="#main-content">Saltar al contenido principal</a>
		<Header />
		<main id="main-content" class="faq-page" tabindex="-1" transition:name="page-main" transition:animate="fade">
			<header class="faq-page__heading">
				<img src={faqIcon.src} alt="" width="64" height="64" />
				<h1>Preguntas Frecuentes</h1>
			</header>

			<div class="faq-page__questions">
				{faqs.map((faq, index) => (
					<details class="faq-item" name="preguntas-frecuentes" id={faq.id} open={index === 0}>
						<summary>
							<h2>{faq.question}</h2>
							<svg class="faq-item__chevron" viewBox="0 0 20 20" width="18" height="18" fill="none" aria-hidden="true">
								<path d="m5 8 5 5 5-5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
							</svg>
						</summary>
						<div class="faq-item__panel">
							<div class="faq-item__answer">
								{faq.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
								{faq.links && (
									<div class="faq-item__links">
										{faq.links.map((link) => <a href={link.href}>{link.label} <span aria-hidden="true">→</span></a>)}
									</div>
								)}
							</div>
						</div>
					</details>
				))}
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	.faq-page {
		min-height: 100svh;
		padding: 168px 24px 88px;
		background: var(--color-surface);
	}

	.faq-page__heading {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 24px;
		margin-bottom: 96px;
	}

	.faq-page__heading img {
		width: 64px;
		height: 64px;
		flex-shrink: 0;
	}

	h1 {
		font-size: 42px;
		font-weight: 700;
		line-height: 1.15;
		letter-spacing: -0.6px;
	}

	.faq-page__questions {
		display: grid;
		gap: 12px;
		width: min(100%, 900px);
		margin-inline: auto;
	}

	.faq-item {
		border: 1px solid #ededed;
		border-radius: 28px;
		background: var(--color-white);
		box-shadow: 0 2px 4px rgb(0 0 0 / 5%);
		scroll-margin-top: 112px;
	}

	summary {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 24px;
		min-height: 56px;
		padding: 14px 36px;
		border-radius: 28px;
		list-style: none;
		cursor: pointer;
	}

	summary::-webkit-details-marker {
		display: none;
	}

	summary:focus-visible {
		outline-offset: -4px;
	}

	h2 {
		font-size: 22px;
		font-weight: 700;
		line-height: 1.25;
		letter-spacing: -0.3px;
	}

	.faq-item__chevron {
		flex-shrink: 0;
		color: #9b9b99;
		transition: transform 360ms cubic-bezier(0.22, 1, 0.36, 1), color 240ms ease;
	}

	.faq-item[open] .faq-item__chevron {
		color: var(--color-text);
		transform: rotate(180deg);
	}

	.faq-item__panel {
		min-height: 0;
		overflow: hidden;
	}

	@supports selector(details::details-content) and (transition-behavior: allow-discrete) {
		.faq-item::details-content {
			display: grid;
			grid-template-rows: 0fr;
			opacity: 0;
			transition:
				grid-template-rows 360ms cubic-bezier(0.22, 1, 0.36, 1),
				opacity 240ms ease,
				content-visibility 360ms allow-discrete;
		}

		.faq-item[open]::details-content {
			grid-template-rows: 1fr;
			opacity: 1;
		}

		.faq-item__answer {
			transform: translateY(-6px);
			transition: transform 360ms cubic-bezier(0.22, 1, 0.36, 1);
		}

		.faq-item[open] .faq-item__answer {
			transform: translateY(0);
		}
	}

	.faq-item__answer {
		padding: 0 78px 22px 36px;
		color: #696967;
		font-size: 16px;
		line-height: 1.5;
	}

	.faq-item__answer p + p {
		margin-top: 12px;
	}

	.faq-item__links {
		display: flex;
		flex-wrap: wrap;
		gap: 12px 24px;
		margin-top: 16px;
	}

	.faq-item__links a {
		color: var(--color-primary);
		font-size: 14px;
		font-weight: 600;
		text-decoration: underline;
		text-decoration-color: transparent;
		text-underline-offset: 4px;
	}

	.faq-item__links a:hover {
		text-decoration-color: currentColor;
	}

	.faq-item__links span {
		margin-left: 4px;
	}

	@media (max-width: 767px) {
		.faq-page {
			padding: 144px 20px 64px;
		}

		.faq-page__heading {
			gap: 16px;
			margin-bottom: 48px;
		}

		.faq-page__heading img {
			width: 48px;
			height: 48px;
		}

		h1 {
			max-width: 11ch;
			font-size: 32px;
		}

		.faq-page__questions {
			gap: 10px;
		}

		summary {
			gap: 16px;
			padding: 16px 24px;
		}

		h2 {
			font-size: 18px;
			line-height: 1.35;
			letter-spacing: -0.2px;
		}

		.faq-item__answer {
			padding: 0 24px 24px;
			font-size: 15px;
			line-height: 1.6;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.faq-item::details-content {
			transition: none;
		}

		.faq-item,
		.faq-item * {
			transition: none !important;
		}

		.faq-item__answer {
			transform: none;
		}
	}
</style>
