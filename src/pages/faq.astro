---
import FontHead from '../components/FontHead.astro';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { faqs } from '../data/faqs';
import faqIcon from '../assets/faq-icon.svg';
import logoMark from '../assets/home/logo-mark.svg';
import '../styles/global.css';
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content="Resuelve tus dudas sobre Lobo Kapital, los requisitos del crédito personal y empresarial, las simulaciones y el proceso de solicitud." />
		<meta name="theme-color" content="#c10230" />
		<link rel="icon" type="image/svg+xml" href={logoMark.src} />
		<title>Preguntas frecuentes | Lobo Kapital</title>
		<FontHead />
		<ClientRouter />
	</head>
	<body>
		<a class="skip-link" href="#main-content">Saltar al contenido principal</a>
		<Header />
		<main id="main-content" class="faq-page" tabindex="-1" transition:name="page-main" transition:animate="fade">
			<header class="faq-page__heading">
				<img src={faqIcon.src} alt="" width="64" height="64" />
				<h1>Preguntas Frecuentes</h1>
			</header>

			<div class="faq-page__questions">
				{faqs.map((faq, index) => (
					<details class="faq-item" name="preguntas-frecuentes" id={faq.id} open={index === 0}>
						<summary>
							<h2>{faq.question}</h2>
							<svg class="faq-item__chevron" viewBox="0 0 20 20" width="18" height="18" fill="none" aria-hidden="true">
								<path d="m5 8 5 5 5-5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
							</svg>
						</summary>
						<div class="faq-item__panel">
							<div class="faq-item__answer">
								{faq.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
								{faq.links && (
									<div class="faq-item__links">
										{faq.links.map((link) => <a href={link.href}>{link.label} <span aria-hidden="true">→</span></a>)}
									</div>
								)}
							</div>
						</div>
					</details>
				))}
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	.faq-page {
		min-height: 100svh;
		padding: 10.5rem 1.5rem 5.5rem;
		background: var(--color-surface);
	}

	.faq-page__heading {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 1.5rem;
		margin-bottom: 6rem;
	}

	.faq-page__heading img {
		width: 4rem;
		height: 4rem;
		flex-shrink: 0;
	}

	h1 {
		font-size: 2.625rem;
		font-weight: 700;
		line-height: 1.15;
		letter-spacing: -0.0375rem;
	}

	.faq-page__questions {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 0.75rem;
		width: min(100%, 56.25rem);
		margin-inline: auto;
	}

	.faq-item {
		border: 1px solid #ededed;
		border-radius: 1.75rem;
		background: var(--color-white);
		box-shadow: 0 2px 4px rgb(0 0 0 / 5%);
		scroll-margin-top: 7rem;
	}

	summary {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		min-height: 3.5rem;
		padding: 0.875rem 2.25rem;
		border-radius: 1.75rem;
		list-style: none;
		cursor: pointer;
	}

	summary::-webkit-details-marker {
		display: none;
	}

	summary:focus-visible {
		outline-offset: -4px;
	}

	h2 {
		font-size: 1.375rem;
		font-weight: 700;
		line-height: 1.25;
		letter-spacing: -0.01875rem;
	}

	.faq-item__chevron {
		flex-shrink: 0;
		color: #9b9b99;
		transition: transform 360ms cubic-bezier(0.22, 1, 0.36, 1), color 240ms ease;
	}

	.faq-item[open] .faq-item__chevron {
		color: var(--color-text);
		transform: rotate(180deg);
	}

	.faq-item__panel {
		min-height: 0;
		overflow: hidden;
	}

	@supports selector(details::details-content) and (transition-behavior: allow-discrete) {
		.faq-item::details-content {
			display: grid;
			grid-template-rows: 0fr;
			opacity: 0;
			transition:
				grid-template-rows 360ms cubic-bezier(0.22, 1, 0.36, 1),
				opacity 240ms ease,
				content-visibility 360ms allow-discrete;
		}

		.faq-item[open]::details-content {
			grid-template-rows: 1fr;
			opacity: 1;
		}

		.faq-item__answer {
			transform: translateY(-0.375rem);
			transition: transform 360ms cubic-bezier(0.22, 1, 0.36, 1);
		}

		.faq-item[open] .faq-item__answer {
			transform: translateY(0);
		}
	}

	.faq-item__answer {
		padding: 0 4.875rem 1.375rem 2.25rem;
		color: #696967;
		font-size: 1rem;
		line-height: 1.5;
	}

	.faq-item__answer p + p {
		margin-top: 0.75rem;
	}

	.faq-item__links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem 1.5rem;
		margin-top: 1rem;
	}

	.faq-item__links a {
		color: var(--color-primary);
		font-size: 0.875rem;
		font-weight: 600;
		text-decoration: underline;
		text-decoration-color: transparent;
		text-underline-offset: 0.25rem;
	}

	.faq-item__links a:hover {
		text-decoration-color: currentColor;
	}

	.faq-item__links span {
		margin-left: 0.25rem;
	}

	@media (max-width: 47.9375em) {
		.faq-page {
			padding: 9rem 1.25rem 4rem;
		}

		.faq-page__heading {
			gap: 1rem;
			margin-bottom: 3rem;
		}

		.faq-page__heading img {
			width: 3rem;
			height: 3rem;
		}

		h1 {
			max-width: 11ch;
			font-size: 2rem;
		}

		.faq-page__questions {
			gap: 0.625rem;
		}

		summary {
			gap: 1rem;
			padding: 1rem 1.5rem;
		}

		h2 {
			font-size: 1.125rem;
			line-height: 1.35;
			letter-spacing: -0.0125rem;
		}

		.faq-item__answer {
			padding: 0 1.5rem 1.5rem;
			font-size: 0.9375rem;
			line-height: 1.6;
		}
	}

</style>
