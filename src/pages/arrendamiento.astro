---
import '@fontsource-variable/figtree/wght.css';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LeaseHero from '../components/LeaseHero.astro';
import LeaseBenefits from '../components/LeaseBenefits.astro';
import LeaseAssets from '../components/LeaseAssets.astro';
import LeadForm from '../components/LeadForm.astro';
import logoMark from '../assets/home/logo-mark.svg';
import '../styles/global.css';
import '../styles/lease.css';

const title = 'Arrendamiento Puro | Lobo Kapital';
const description = 'Arrendamiento puro para adquirir maquinaria, equipo o vehículos sin descapitalizar tu empresa.';
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#c10230" />
		<link rel="icon" type="image/svg+xml" href={logoMark.src} />
		<title>{title}</title>
		<ClientRouter />
	</head>
	<body class="lease-page">
		<a class="skip-link" href="#main-content">Saltar al contenido principal</a>
		<Header />
		<main id="main-content" tabindex="-1" transition:name="page-main" transition:animate="fade">
			<LeaseHero />
			<LeaseBenefits />
			<LeaseAssets />
			<LeadForm product="lease" sectionId="solicitud" />
		</main>
		<Footer />
	</body>
</html>
