---
import FontHead from '../components/FontHead.astro';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { legalEntity, legalLinks } from '../data/legal';
import logoMark from '../assets/home/logo-mark.svg';
import '../styles/global.css';
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content="Contacta a la Unidad Especializada de Atención a Usuarios (UNE) de Lobos Gestión Empresarial para consultas, aclaraciones y reclamaciones." />
		<meta name="theme-color" content="#c10230" />
		<link rel="icon" type="image/svg+xml" href={logoMark.src} />
		<title>UNE · Atención a usuarios | Lobo Kapital</title>
		<FontHead />
		<ClientRouter />
	</head>
	<body>
		<a class="skip-link" href="#main-content">Saltar al contenido principal</a>
		<Header />
		<main id="main-content" class="une-page" tabindex="-1" transition:name="page-main" transition:animate="fade">
			<header class="une-page__heading">
				<p class="une-page__eyebrow">Unidad Especializada de Atención a Usuarios</p>
				<h1>Atención a <span>usuarios</span></h1>
				<p>La Unidad Especializada de Atención a Usuarios (UNE) de Lobos Gestión Empresarial, adscrita a la Dirección de Operaciones, recibe tus consultas, aclaraciones y reclamaciones.</p>
			</header>

			<div class="une-page__channels">
				<section class="une-contact" aria-labelledby="une-contact-title">
					<h2 id="une-contact-title">Contacto con la UNE</h2>
					<a class="une-contact__email" href={`mailto:${legalEntity.uneEmail}`}>{legalEntity.uneEmail}</a>
					<p>Incluye tu nombre, un medio para responderte y una descripción de tu consulta. Si ya tienes una referencia de atención, indícala.</p>
					<p>No envíes contraseñas, NIP ni códigos de acceso.</p>
					<div class="une-contact__address">
						<h3>Domicilio de atención</h3>
						<address>{legalEntity.address}</address>
					</div>
				</section>

				<div class="une-page__other-channels">
					<section aria-labelledby="une-privacy-title">
						<h2 id="une-privacy-title">Datos personales y derechos ARCO</h2>
						<p>Para acceso, rectificación, cancelación, oposición, revocación del consentimiento o limitación del uso de tus datos:</p>
						<a class="une-page__email" href={`mailto:${legalEntity.privacyEmail}`}>{legalEntity.privacyEmail}</a>
						<a class="une-page__procedure" href={legalLinks.arco}>Consultar el procedimiento ARCO <span aria-hidden="true">→</span></a>
					</section>
					<section aria-labelledby="une-integrity-title">
						<h2 id="une-integrity-title">Integridad institucional</h2>
						<a class="une-page__email" href={`mailto:${legalEntity.integrityEmail}`}>{legalEntity.integrityEmail}</a>
					</section>
				</div>
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	.une-page {
		width: min(calc(100% - 6rem), 79.75rem);
		margin-inline: auto;
		padding-block: 10.75rem 5rem;
		font-size: 1rem;
		line-height: 1.65;
	}

	.une-page__heading {
		max-width: 48.75rem;
		margin-bottom: 4rem;
	}

	.une-page__eyebrow {
		margin-bottom: 1.25rem;
		color: #696967;
		font-size: 0.875rem;
		font-weight: 600;
	}

	h1 {
		margin-bottom: 1.5rem;
		color: #000;
		font-size: clamp(2.5rem, 4.5vw, 3.75rem);
		font-weight: 700;
		line-height: 1.08;
		letter-spacing: -0.035em;
	}

	h1 span {
		color: var(--color-primary);
	}

	.une-page__heading > p:last-child {
		color: #696967;
		font-size: 1.125rem;
	}

	.une-page__channels {
		display: grid;
		grid-template-columns: 1.1fr 1fr;
		align-items: start;
		gap: 4.5rem;
	}

	.une-page__channels > * {
		min-width: 0;
		overflow-wrap: anywhere;
	}

	h2 {
		margin-bottom: 1.25rem;
		color: #000;
		font-size: 1.625rem;
		font-weight: 650;
		line-height: 1.25;
		letter-spacing: -0.025em;
	}

	.une-page a {
		text-decoration: underline;
		text-decoration-color: #b8b8b8;
		text-underline-offset: 0.25rem;
	}

	.une-page a:hover {
		color: var(--color-primary);
		text-decoration-color: currentColor;
	}

	.une-contact {
		padding: 2.25rem;
		border-radius: 1.25rem;
		background: var(--color-surface);
	}

	.une-contact__email {
		display: inline-block;
		margin-bottom: 1.5rem;
		font-size: clamp(1.25rem, 2vw, 1.625rem);
		font-weight: 600;
		line-height: 1.4;
		letter-spacing: -0.02em;
	}

	.une-contact p + p {
		margin-top: 1rem;
		color: #696967;
		font-size: 0.875rem;
	}

	.une-contact__address {
		margin-top: 1.75rem;
		padding-top: 1.5rem;
		border-top: 1px solid #dedede;
	}

	h3 {
		margin-bottom: 0.625rem;
		color: #696967;
		font-size: 0.875rem;
		font-weight: 600;
	}

	address {
		font-style: normal;
	}

	.une-page__other-channels {
		padding-top: 0.5rem;
	}

	.une-page__other-channels section + section {
		margin-top: 2.25rem;
		padding-top: 2rem;
		border-top: 1px solid #dedede;
	}

	.une-page__email {
		display: inline-block;
		font-weight: 600;
	}

	.une-page__other-channels p + a {
		margin-top: 1rem;
	}

	.une-page__procedure {
		display: block;
		width: fit-content;
		margin-top: 1.5rem;
		font-size: 0.875rem;
		font-weight: 600;
	}

	.une-page__procedure span {
		display: inline-block;
		margin-left: 0.5rem;
	}

	@media (max-width: 62.5em) {
		.une-page__channels {
			gap: 2.5rem;
		}

		.une-contact {
			padding: 1.75rem;
		}
	}

	@media (max-width: 47.9375em) {
		.une-page {
			width: calc(100% - 2.5rem);
			padding-block: 8.75rem 3rem;
		}

		.une-page__heading {
			margin-bottom: 2.5rem;
		}

		.une-page__heading > p:last-child {
			font-size: 1.0625rem;
		}

		.une-page__channels {
			grid-template-columns: minmax(0, 1fr);
			gap: 2.5rem;
		}

		h2 {
			font-size: 1.5rem;
		}

		.une-contact {
			padding: 1.75rem 1.5rem;
		}

		.une-page__other-channels {
			padding-top: 0;
		}
	}
</style>
