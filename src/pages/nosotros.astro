---
import FontHead from '../components/FontHead.astro';
import { ClientRouter } from 'astro:transitions';
import { Picture } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageReveals from '../components/PageReveals.astro';
import teamImage from '../assets/about/equipo.jpg';
import logoMark from '../assets/home/logo-mark.svg';
import '../styles/global.css';

const values = [
	{
		title: 'Agilidad sin fricción',
		description: 'Evaluaciones financieras eficientes y seguimiento cercano durante cada etapa del proceso.',
	},
	{
		title: 'Transparencia absoluta',
		description: 'Claridad total en nuestras condiciones, comisiones y contratos. Sin letras pequeñas ni costos ocultos.',
	},
	{
		title: 'Empatía comercial',
		description: 'Entendemos tu negocio más allá de un expediente; evaluamos proyectos y capacidad de pago con flexibilidad.',
	},
	{
		title: 'Respeto a la norma',
		description: 'Operamos conforme al marco aplicable a una SOFOM, E.N.R., con supervisión de la CNBV únicamente en los términos del artículo 95 Bis de la LGOAAC.',
	},
];
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content="Conoce Lobo Kapital, nuestra visión y los valores que guían nuestras soluciones de crédito, arrendamiento y factoraje." />
		<meta name="theme-color" content="#c10230" />
		<link rel="icon" type="image/svg+xml" href={logoMark.src} />
		<title>Nosotros | Lobo Kapital</title>
		<FontHead />
		<ClientRouter />
	</head>
	<body>
		<a class="skip-link" href="#main-content">Saltar al contenido principal</a>
		<Header />
		<main id="main-content" class="about-page" tabindex="-1" transition:name="page-main" transition:animate="fade">
			<section class="about-intro" aria-labelledby="about-title">
				<h1 id="about-title">Nosotros</h1>
				<div class="about-intro__card">
					<p>Nacimos con una visión clara: romper las barreras del financiamiento tradicional para ofrecer alternativas de crédito, arrendamiento y factoraje estructuradas a la velocidad que exige el mercado actual. Como SOFOM, E.N.R., combinamos la solidez institucional con un modelo de atención flexible para entender la realidad de cada negocio.</p>
				</div>
			</section>

			<section class="about-banner" aria-labelledby="about-banner-title">
				<Picture
					src={teamImage}
					formats={['avif', 'webp']}
					widths={[640, 960, 1280, 1920, 2560, 3840]}
					sizes="(max-width: 95.25em) 95.25rem, 100vw"
					alt="Profesionales conversando en una oficina"
					width={1920}
					height={302}
					loading="eager"
					fetchpriority="high"
				/>
				<h2 id="about-banner-title" data-page-reveal>Impulsamos el potencial de tu negocio con soluciones financieras ágiles</h2>
			</section>

			<section class="about-values" aria-labelledby="about-values-title">
				<header class="about-values__heading" data-page-reveal>
					<p>Valores Lobo Kapital</p>
					<h2 id="about-values-title">Tu <span>aliado estratégico</span> en financiamiento y crecimiento empresarial.</h2>
				</header>
				<ul class="about-values__list" role="list" data-page-reveal-group>
					{values.map((value) => (
						<li data-page-reveal><h3>{value.title}</h3><p>{value.description}</p></li>
					))}
				</ul>
			</section>
		</main>
		<Footer />
		<PageReveals />
	</body>
</html>

<style>
	.about-intro {
		padding: 10.5rem 1.5rem 5.125rem;
	}

	h1 {
		color: var(--color-primary);
		font-size: 2.75rem;
		font-weight: 700;
		line-height: 1.25;
		text-align: center;
	}

	.about-intro__card {
		width: min(100%, 59rem);
		margin: 2.25rem auto 0;
		padding: 2rem 2.5rem;
		border-radius: 1.5rem;
		background: var(--color-surface);
		color: var(--color-text);
		font-size: 1.125rem;
		line-height: 1.65;
	}

	.about-banner {
		position: relative;
		display: grid;
		min-height: clamp(15rem, 15.75vw, 21.25rem);
		place-items: center;
		padding: 4rem 1.5rem;
		isolation: isolate;
		overflow: hidden;
		border-radius: clamp(6rem, 15.75vw, 18.875rem) clamp(6rem, 15.75vw, 18.875rem) 0 0;
		background: var(--color-dark);
	}

	.about-banner :global(picture) {
		position: absolute;
		inset: 0;
		z-index: -2;
	}

	.about-banner :global(img) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
	}

	.about-banner::before {
		position: absolute;
		inset: 0;
		z-index: -1;
		background: rgb(0 0 0 / 46%);
		content: '';
	}

	.about-banner h2 {
		max-width: 79.75rem;
		color: var(--color-white);
		font-size: 2rem;
		font-weight: 650;
		line-height: 1.25;
		letter-spacing: -0.025rem;
		text-align: center;
	}

	.about-values {
		padding: 5.5rem 1.5rem 6rem;
		background: var(--color-surface);
	}

	.about-values__heading {
		width: min(100%, 79.75rem);
		margin-inline: auto;
		text-align: center;
	}

	.about-values__heading > p {
		color: var(--color-muted);
		font-size: 1.5rem;
		font-weight: 600;
		line-height: 1.25;
	}

	.about-values__heading h2 {
		margin-top: 1.75rem;
		color: var(--color-dark);
		font-size: 2rem;
		font-weight: 700;
		line-height: 1.25;
		letter-spacing: -0.025rem;
	}

	.about-values__heading h2 span {
		color: var(--color-primary);
	}

	.about-values__list {
		display: grid;
		gap: 1rem;
		width: min(100%, 59.625rem);
		margin: 2.5rem auto 0;
		padding: 0;
		list-style: none;
	}

	.about-values__list li {
		display: grid;
		align-items: center;
		padding: 1.75rem 2rem;
		border-radius: 1.25rem;
		background: var(--color-white);
		color: var(--color-text);
		font-size: 1rem;
		line-height: 1.6;
	}

	.about-values__list h3 {
		margin-bottom: 0.5rem;
		color: var(--color-ink);
		font-size: 1.375rem;
		font-weight: 650;
		line-height: 1.25;
	}

	@media (max-width: 47.9375em) {
		h1 {
			font-size: 2.375rem;
		}
		.about-intro {
			padding: 8.75rem 1.25rem 3rem;
		}

		.about-intro__card {
			margin-top: 1.75rem;
			padding: 1.5rem;
			border-radius: 1.75rem;
			font-size: 1.0625rem;
		}

		.about-banner {
			padding: 3rem 1.5rem;
			border-radius: 4.5rem 4.5rem 0 0;
		}

		.about-banner :global(img) {
			object-position: 56% center;
		}

		.about-banner h2 {
			font-size: 1.75rem;
		}

		.about-values {
			padding: 4rem 1.25rem 5rem;
		}

		.about-values__heading > p {
			font-size: 1.25rem;
		}

		.about-values__heading h2 {
			margin-top: 1.25rem;
			font-size: 1.75rem;
		}

		.about-values__list {
			gap: 1rem;
			margin-top: 2.5rem;
		}

		.about-values__list li {
			padding: 1.5rem;
			border-radius: 1.75rem;
		}
	}
</style>
