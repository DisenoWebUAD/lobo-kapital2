---
import FontHead from '../components/FontHead.astro';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import PersonalLoanHero from '../components/PersonalLoanHero.astro';
import CreditDetails from '../components/CreditDetails.astro';
import PersonalLoanRequirements from '../components/PersonalLoanRequirements.astro';
import PersonalLoanConditions from '../components/PersonalLoanConditions.astro';
import PersonalLoanCalculator from '../components/PersonalLoanCalculator.astro';
import PersonalLoanUses from '../components/PersonalLoanUses.astro';
import LeadForm from '../components/LeadForm.astro';
import Footer from '../components/Footer.astro';
import PageReveals from '../components/PageReveals.astro';
import logoMark from '../assets/home/logo-mark.svg';
import '../styles/global.css';

const title = 'Crédito Personal | Lobo Kapital';
const description = 'Crédito personal de $30,000 a $200,000 MXN en Durango. Consulta montos, plazos, condiciones orientativas y requisitos para la evaluación.';
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#c10230" />
		<link rel="icon" type="image/svg+xml" href={logoMark.src} />
		<title>{title}</title>
		<FontHead />
		<ClientRouter />
	</head>
	<body class="personal-loan-page">
		<a class="skip-link" href="#main-content">Saltar al contenido principal</a>
		<Header />
		<main id="main-content" tabindex="-1" transition:name="page-main" transition:animate="fade">
			<PersonalLoanHero />
			<CreditDetails product="personal">
				<PersonalLoanRequirements slot="heading" />
				<PersonalLoanConditions slot="conditions" />
			</CreditDetails>
			<PersonalLoanCalculator />
			<PersonalLoanUses />
			<LeadForm product="personal" />
		</main>
		<Footer />
		<PageReveals />
	</body>
</html>
