---
import heroImage from "../assets/arrendamiento/hero.jpg";
---

<section class="lease-hero" id="inicio" aria-labelledby="lease-hero-title">
	<div class="lease-hero__copy">
		<h1 id="lease-hero-title">
			Optimiza tu <span>Capital</span><br />con Arrendamiento Puro
		</h1>
		<p>
			Utiliza el equipo, maquinaria o vehículos que tu empresa necesita
			mediante rentas periódicas.<br class="lease-desktop-break" /> Conserva
			recursos para tu operación y explora opciones para renovar los activos
			al concluir el contrato.
		</p>
		<div class="lease-hero__actions">
			<a class="button button--primary" href="#simulador"
				>Simula tu Arrendamiento</a
			>
			<a class="button button--light lease-hero__more" href="#solicitud"
				>Pedir información</a
			>
		</div>
	</div>

	<div class="lease-hero__media-frame">
		<svg
			class="lease-hero__media"
			viewBox="0 0 1920 532.39"
			role="img"
			aria-label="Panadero trabajando en su negocio"
		>
			<defs>
				<clipPath id="lease-hero-clip">
					<path
						d="M280.16 0H1639.84C1794.57 0 1920 125.43 1920 280.16V532.39H0V280.16C0 125.43 125.43 0 280.16 0Z"
					></path>
				</clipPath>
			</defs>
			<image
				href={heroImage.src}
				x="-8.96"
				y="-225.41"
				width="1928.96"
				height="1285.97"
				preserveAspectRatio="none"
				clip-path="url(#lease-hero-clip)"
			/>
		</svg>
	</div>
</section>
