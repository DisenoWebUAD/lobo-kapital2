---
import { guideNeeds, guideCapitalUses, guideEquipmentUses, guideProducts, guideProductOrder } from "../data/product-guide";
const preferences = [
	{ name: 'capitalUse', label: '¿Cómo necesitas usar ese dinero?', options: guideCapitalUses },
	{ name: 'equipmentUse', label: '¿Cómo quieres incorporar el activo?', options: guideEquipmentUses },
];
---

<section class="product-guide" id="elige-tu-financiamiento" aria-labelledby="guide-title">
	<lobo-product-guide>
		<header class="product-guide__heading">
			<h2 id="guide-title">¿No sabes qué <span>producto elegir?</span></h2>
			<p>Cuéntanos qué necesita tu negocio. Te mostramos opciones y las razones para explorarlas.</p>
		</header>
		<div class="product-guide__layout">
			<form data-guide-form novalidate hidden>
				<fieldset disabled data-guide-fields>
					<legend class="product-guide__sr-only">Necesidades y preferencias de tu negocio</legend>
					<fieldset class="product-guide__field" data-guide-field="need" aria-describedby="guide-need-error">
						<legend>¿Qué necesitas para tu negocio?</legend>
						<div class="product-guide__choices product-guide__choices--needs">
							{guideNeeds.map(({ value, label }) => (
								<label class="product-guide__choice">
									<input id={`guide-need-${value}`} type="radio" name="need" value={value} required aria-describedby="guide-need-error" />
									<span>{label}</span>
								</label>
							))}
						</div>
						<p class="product-guide__error" id="guide-need-error" data-guide-error="need"></p>
					</fieldset>
					{preferences.map(({ name, label, options }) => (
						<div class="product-guide__slot" data-guide-slot={name} hidden>
							<div data-guide-inner>
								<fieldset class="product-guide__field" data-guide-field={name} aria-describedby={`guide-${name}-error`}>
									<legend>{label}</legend>
									<div class="product-guide__choices product-guide__choices--preferences">
										{options.map(({ value, label: optionLabel }) => (
											<label class="product-guide__choice">
												<input id={`guide-${name}-${value}`} type="radio" name={name} value={value} aria-describedby={`guide-${name}-error`} />
												<span>{optionLabel}</span>
											</label>
										))}
									</div>
									<p class="product-guide__error" id={`guide-${name}-error`} data-guide-error={name}></p>
								</fieldset>
							</div>
						</div>
					))}
					<div class="product-guide__slot" data-guide-slot="amount" hidden>
						<div data-guide-inner>
							<div class="product-guide__field" data-guide-field="amount">
								<label for="guide-amount">Monto solicitado <span>(opcional)</span></label>
								<div class="product-guide__amount">
									<input id="guide-amount" name="amount" type="text" inputmode="numeric" autocomplete="off" placeholder="$0" maxlength="24" aria-describedby="guide-amount-error" />
									<span aria-hidden="true">MXN</span>
								</div>
								<p class="product-guide__error" id="guide-amount-error" data-guide-error="amount"></p>
							</div>
						</div>
					</div>
				</fieldset>
			</form>
			<div class="product-guide__output" data-guide-output hidden>
				<div class="product-guide__output-inner" data-guide-output-inner>
					<div class="product-guide__empty" data-guide-empty>
						<h3>Tus opciones, aquí</h3>
						<p data-guide-empty-message>Elige qué necesita tu negocio para empezar.</p>
					</div>
					<div class="product-guide__results" id="guide-results" data-guide-results role="region" aria-labelledby="guide-results-title" tabindex="-1" hidden>
						<h3 id="guide-results-title">Opciones para explorar</h3>
						<ul data-guide-recommendations></ul>
					</div>
				</div>
			</div>
			<noscript>
				<div class="product-guide__fallback">
					<p>Explora estas opciones y consulta cuál corresponde a tu objetivo:</p>
					<ul>{guideProductOrder.map((id) => <li><a href={guideProducts[id].href}>{guideProducts[id].title} <span aria-hidden="true">→</span></a></li>)}</ul>
				</div>
			</noscript>
		</div>
		<p class="product-guide__sr-only" data-guide-status role="status" aria-atomic="true"></p>
		<p class="product-guide__scope">Esta guía orienta tu búsqueda; la disponibilidad y las condiciones dependen de la evaluación de tu caso. No representa una autorización ni una oferta. Consulta requisitos y condiciones en cada producto.</p>
	</lobo-product-guide>
</section>

<script>
	import { registerProductGuide } from "../lib/product-guide-client";
	registerProductGuide();
</script>

<style>
	.product-guide {
		--guide-control-ink: #242424;
		width: min(calc(100% - 6rem), 79.75rem);
		margin: 0 auto 6rem;
		padding: clamp(2rem, 4vw, 3.5rem);
		border-radius: 1.5rem;
		background: var(--color-surface);
		scroll-margin-top: 7rem;
	}
	lobo-product-guide { display: block; }
	.product-guide__heading { margin-bottom: clamp(2rem, 3vw, 2.75rem); }
	.product-guide__heading h2 {
		color: var(--color-ink);
		font-size: clamp(2.25rem, 3.8vw, 3.5rem);
		font-weight: 650;
		line-height: 1.08;
		letter-spacing: -0.04em;
	}
	.product-guide__heading h2 span { color: var(--color-primary); }
	.product-guide__heading > p {
		max-width: 76ch;
		margin-top: 1.25rem;
		font-size: 1.0625rem;
		line-height: 1.6;
	}
	.product-guide__layout {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		align-items: start;
		gap: 2rem;
	}
	form[hidden],
	.product-guide__output[hidden],
	.product-guide__empty[hidden],
	.product-guide__results[hidden],
	.product-guide__slot[hidden],
	[data-guide-field][hidden] { display: none; }
	form, fieldset, .product-guide__field { min-width: 0; }
	fieldset { margin: 0; padding: 0; border: 0; }
	.product-guide__field > legend,
	.product-guide__field > label {
		display: block;
		width: 100%;
		margin-bottom: .875rem;
		padding: 0;
		color: var(--color-ink);
		font-size: 1rem;
		font-weight: 550;
		line-height: 1.5;
	}
	.product-guide__field > label > span {
		color: var(--color-muted);
		font-size: .875rem;
		font-weight: 400;
	}
	.product-guide__choices { display: grid; grid-auto-rows: 1fr; gap: .5rem; }
	.product-guide__choices--needs {
		/* Keep two equal columns when labels have room, including enlarged text. */
		grid-template-columns: repeat(auto-fit, minmax(min(100%, max(9rem, calc((100% - .5rem) / 2))), 1fr));
	}
	.product-guide__choice {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: center;
		min-width: 0;
		min-height: 3rem;
		padding: .5rem 1rem;
		border: 1px solid #8a8a86;
		border-radius: 999px;
		color: var(--guide-control-ink);
		background: var(--color-white);
		font-size: 1rem;
		font-weight: 500;
		line-height: 1.4;
		text-align: center;
		cursor: pointer;
		-webkit-tap-highlight-color: transparent;
		transition: color 140ms ease, background-color 140ms ease, border-color 140ms ease, transform 140ms ease;
	}
	.product-guide__choice > input {
		/* Keep the native radio's semantics and keyboard behavior; paint the label. */
		position: absolute;
		top: 50%;
		left: 50%;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		border: 0;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}
	.product-guide__choice > span { min-width: 0; overflow-wrap: anywhere; }
	.product-guide__choice:has(input:checked) {
		border-color: var(--guide-control-ink);
		color: var(--color-white);
		background: var(--guide-control-ink);
	}
	.product-guide__choice:has(input:focus-visible) {
		outline: 2px solid var(--guide-control-ink);
		outline-offset: 3px;
	}
	.product-guide__choice > input:focus-visible { outline: 0; }
	.product-guide__choice:active {
		background: #e4e4e1;
		transform: translateY(1px) scale(.995);
		transition-duration: 70ms;
	}
	.product-guide__choice:has(input:checked):active { background: #181818; }
	.product-guide__slot { min-width: 0; padding: 0; }
	.product-guide__slot > [data-guide-inner] { padding-top: 1.5rem; }
	.product-guide__amount { position: relative; }
	.product-guide__amount input {
		display: block;
		width: 100%;
		min-width: 0;
		min-height: 4.25rem;
		padding: .875rem 3.75rem .875rem 1rem;
		border: 2px solid #b6b6b2;
		border-radius: .875rem;
		color: var(--color-ink);
		background: var(--color-white);
		font-size: clamp(1.375rem, 2vw, 1.625rem);
		font-weight: 550;
		font-variant-numeric: tabular-nums;
		letter-spacing: -.02em;
		transition: border-color 140ms ease, background-color 140ms ease;
	}
	.product-guide__amount input::placeholder { color: #73736e; opacity: 1; }
	.product-guide__amount > span {
		position: absolute;
		top: 50%;
		right: 1rem;
		color: var(--color-muted);
		font-size: .8125rem;
		transform: translateY(-50%);
		pointer-events: none;
	}
	.product-guide__amount input:focus-visible {
		border-color: var(--guide-control-ink);
		outline: 2px solid var(--guide-control-ink);
		outline-offset: 3px;
	}
	.product-guide__amount input[aria-invalid="true"] { border-color: var(--color-primary); }
	.product-guide__amount input[aria-invalid="true"]:focus-visible { outline-color: var(--color-primary); }
	.product-guide__error {
		margin-top: .625rem;
		color: #a30029;
		font-size: .875rem;
		line-height: 1.5;
	}
	.product-guide__error:empty { display: none; }
	.product-guide__output {
		min-width: 0;
		padding: 0;
		border-radius: 1.125rem;
		background: var(--color-white);
	}
	.product-guide__output-inner {
		position: relative;
		min-width: 0;
		padding: 2rem;
	}
	.product-guide__empty > h3 {
		color: var(--color-ink);
		font-size: 1.375rem;
		font-weight: 600;
		line-height: 1.3;
		letter-spacing: -.02em;
	}
	.product-guide__empty > p {
		max-width: 36ch;
		margin-top: .625rem;
		color: var(--color-muted);
		font-size: 1rem;
		line-height: 1.6;
	}
	.product-guide__results { min-width: 0; scroll-margin-top: 7rem; }
	.product-guide__results:focus-visible {
		outline: 2px solid var(--color-primary);
		outline-offset: .75rem;
		border-radius: .25rem;
	}
	.product-guide__results > h3 {
		color: var(--color-muted);
		font-size: .9375rem;
		font-weight: 500;
		line-height: 1.5;
		letter-spacing: 0;
	}
	.product-guide__results > ul {
		position: relative;
		display: grid;
		gap: 1.5rem;
		margin-top: 1.5rem;
		padding: 0;
		list-style: none;
	}
	.product-guide__results :global([data-guide-product]) { position: relative; z-index: 1; min-width: 0; }
	.product-guide__results :global([data-guide-product][data-guide-exiting]) { z-index: 0; }
	.product-guide__results :global(.product-guide__card-content) { position: relative; background: var(--color-white); }
	.product-guide__results :global([data-guide-product] [hidden]) { display: none; }
	.product-guide__results :global(.product-guide__product-link) {
		display: block;
		margin: -.625rem;
		padding: .625rem;
		border-radius: .625rem;
		color: var(--color-ink);
		text-decoration: none;
		transition: background-color 140ms ease;
	}
	.product-guide__results :global(.product-guide__product-title) {
		display: flex;
		align-items: start;
		justify-content: space-between;
		gap: 1rem;
	}
	.product-guide__results :global(h4) {
		min-width: 0;
		margin: 0;
		color: var(--color-ink);
		font-size: 1.375rem;
		font-weight: 650;
		line-height: 1.25;
		letter-spacing: -.025em;
		overflow-wrap: anywhere;
	}
	.product-guide__results[data-count="1"] :global(h4) {
		font-size: clamp(1.625rem, 2.4vw, 2rem);
		letter-spacing: -.035em;
	}
	.product-guide__results :global(.product-guide__product-title > span) {
		flex: 0 0 auto;
		color: var(--color-primary);
		font-size: 1.5rem;
		line-height: 1.2;
	}
	.product-guide__results :global([data-guide-reason]) {
		max-width: 60ch;
		margin-top: .625rem;
		color: var(--color-ink);
		font-size: 1rem;
		font-weight: 400;
		line-height: 1.6;
	}
	.product-guide__results :global(.product-guide__action) {
		display: inline-flex;
		align-items: center;
		min-height: 2.75rem;
		margin-top: .875rem;
		color: var(--color-primary);
		font-size: 1rem;
		font-weight: 600;
	}
	.product-guide__results:not([data-count="1"]) :global(.product-guide__action) { display: none; }
	.product-guide__results :global(.product-guide__notes) { min-width: 0; padding: 0; }
	.product-guide__results :global([data-guide-notes-inner]) { padding-top: 1rem; }
	.product-guide__results :global(.product-guide__warnings) {
		display: grid;
		gap: .5rem;
		margin-top: .375rem;
		padding-left: 1.125rem;
		color: var(--color-muted);
		font-size: .875rem;
		line-height: 1.6;
	}
	.product-guide__results :global(.product-guide__review) {
		color: var(--color-ink);
		font-size: .9375rem;
		font-weight: 600;
		line-height: 1.5;
	}
	.product-guide__results :global(.product-guide__amount-match) {
		color: var(--color-muted);
		font-size: .875rem;
		line-height: 1.6;
	}
	.product-guide__results :global(.product-guide__contact) {
		display: inline-flex;
		align-items: center;
		gap: .5rem;
		min-height: 2.75rem;
		margin-top: .5rem;
		color: var(--color-primary);
		font-size: .9375rem;
		font-weight: 600;
	}
	.product-guide__results :global(.product-guide__product-link:focus-visible),
	.product-guide__results :global(.product-guide__contact:focus-visible) {
		outline: 2px solid var(--color-primary);
		outline-offset: 3px;
	}
	.product-guide__results :global(.product-guide__product-link:active) { background: #fff1f4; }
	.product-guide__results :global(.product-guide__contact:hover) { text-decoration: underline; text-underline-offset: .2em; }
	.product-guide__scope {
		margin-top: 2rem;
		color: var(--color-muted);
		font-size: .875rem;
		line-height: 1.6;
	}
	.product-guide__layout > :global(noscript) { grid-column: 1 / -1; }
	.product-guide__fallback p { font-size: 1.0625rem; line-height: 1.6; }
	.product-guide__fallback ul { display: grid; gap: .5rem; margin-top: 1.25rem; padding: 0; list-style: none; }
	.product-guide__fallback a {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		min-height: 2.75rem;
		padding-block: .5rem;
		color: var(--color-primary);
		font-weight: 600;
	}
	.product-guide__fallback a:hover { text-decoration: underline; }
	.product-guide__sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
		border: 0;
	}
	@media (hover: hover) {
		.product-guide__choice:hover:not(:active) { border-color: #73736e; background: #f8f8f6; }
		.product-guide__choice:has(input:checked):hover:not(:active) { border-color: var(--guide-control-ink); background: #303030; }
		.product-guide__amount input:hover:not(:focus-visible):not([aria-invalid="true"]) { border-color: #85857f; }
		.product-guide__results :global(.product-guide__product-link:hover) { background: #f8f8f6; }
		.product-guide__results :global(.product-guide__product-link:hover h4) { color: var(--color-primary); }
	}
	@media (min-width: 75em) {
		.product-guide__layout { grid-template-columns: minmax(0, 45fr) minmax(0, 55fr); gap: clamp(2rem, 4vw, 3.5rem); }
	}
	@media (max-width: 74.9375em) {
		.product-guide { width: calc(100% - 4rem); margin-bottom: 4.5rem; padding: 2rem; }
	}
	@media (max-width: 47.9375em) {
		.product-guide { width: calc(100% - 2.5rem); margin-bottom: 3.5rem; padding: 1.5rem; border-radius: 1.125rem; }
		.product-guide__heading h2 { font-size: clamp(1.75rem, 7.6vw, 2.5rem); }
		.product-guide__heading > p { font-size: 1rem; }
		.product-guide__output-inner { padding: 1.25rem; }
		.product-guide__results :global(h4) { font-size: 1.25rem; }
		.product-guide__results[data-count="1"] :global(h4) { font-size: 1.625rem; }
	}
	@media (max-width: 23.9375em) {
		.product-guide { padding: 1.25rem; }
		.product-guide__choices--needs { grid-template-columns: 1fr; }
		.product-guide__amount input { font-size: 1.375rem; padding-inline: .875rem 3.25rem; }
		.product-guide__amount > span { right: .875rem; }
	}
	@media (prefers-reduced-motion: reduce) {
		.product-guide__choice {
			transition: color 80ms linear, background-color 80ms linear, border-color 80ms linear;
			transition-duration: 80ms !important;
		}
		.product-guide__amount input,
		.product-guide__results :global(.product-guide__product-link) { transition: background-color 80ms linear, border-color 80ms linear; }
		.product-guide__choice:active { transform: none; }
	}
	@media (prefers-contrast: more) {
		.product-guide__choice { border-color: #73736e; }
		.product-guide__choice:has(input:checked) { border-color: var(--guide-control-ink); }
		.product-guide__amount input { border-color: #73736e; }
		.product-guide__results > h3,
		.product-guide__scope,
		.product-guide__results :global(.product-guide__amount-match) { color: var(--color-ink); }
	}
	@media (forced-colors: active) {
		.product-guide__choice,
		.product-guide__choice:hover:not(:active),
		.product-guide__choice:active {
			forced-color-adjust: none;
			border-color: ButtonText;
			color: CanvasText;
			background: Canvas;
		}
		.product-guide__choice:has(input:checked),
		.product-guide__choice:has(input:checked):hover:not(:active),
		.product-guide__choice:has(input:checked):active {
			border-color: Highlight;
			color: HighlightText;
			background: Highlight;
		}
		.product-guide__choice:has(input:focus-visible) { outline-color: Highlight; }
	}
</style>
