---
import pymesIcon from "../assets/home/pymes-icon.svg";
import walletIcon from "../assets/home/cartera-icon.svg";
import { credits } from "../data/credits";

const products = [
	{
		...credits.personal,
		icon: walletIcon,
	},
	{
		...credits.business,
		icon: pymesIcon,
	},
];
---

<section class="solutions" id="soluciones" aria-labelledby="solutions-title">
	<div class="section-heading" data-reveal-group="80">
		<h2 id="solutions-title" data-reveal>
			<span>Soluciones</span> a tu medida
		</h2>
		<p data-reveal>
			Experiencia y solidez financiera respaldando cada etapa de tu
			crecimiento personal y empresarial.
		</p>
	</div>

	<div class="solutions__grid" data-reveal-group="80">
		{
			products.map((product) => (
				<article
					class="product-card"
					id={product.id}
					data-reveal
					data-spotlight
				>
					<div class="product-card__icon">
						<img
							src={product.icon.src}
							alt=""
							width="56"
							height="56"
						/>
					</div>
					<h3>{product.title}</h3>
					<p>{product.summary}</p>
					<dl class="product-card__summary">
						<div>
							<dt>Hasta</dt>
							<dd>
								{product.maxAmount}
								<span class="product-card__currency"> MXN</span>
							</dd>
						</div>
						<div>
							<dt>Plazo</dt>
							<dd>
								{product.term}
								<small>{product.termNote}</small>
							</dd>
						</div>
					</dl>
					<a href={product.href}>
						Conocer el crédito <span aria-hidden="true">→</span>
					</a>
				</article>
			))
		}
	</div>
	<p class="solutions__note">Montos y plazos sujetos a evaluación.</p>
</section>
