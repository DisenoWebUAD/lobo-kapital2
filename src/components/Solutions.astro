---
import { Image } from 'astro:assets';
import personalImage from '../assets/editorial/hogar.jpg';
import businessImage from '../assets/editorial/capital.jpg';
import { credits } from "../data/credits";

const products = [
	{
		...credits.personal,
		image: personalImage,
		alt: 'Una pareja preparando mejoras para su hogar',
	},
	{
		...credits.business,
		image: businessImage,
		alt: 'Un equipo atendiendo los pedidos de su negocio',
	},
];
---

<section class="solutions" id="soluciones" aria-labelledby="solutions-title">
	<div class="section-heading" data-reveal-group="80">
		<h2 id="solutions-title" data-reveal>
			<span>Soluciones</span> a tu medida
		</h2>
		<p data-reveal>
			Experiencia y solidez financiera respaldando cada etapa de tu
			crecimiento personal y empresarial.
		</p>
	</div>

	<div class="solutions__grid" data-reveal-group="80">
		{
			products.map((product) => (
				<article
					class="product-card"
					id={product.id}
					data-reveal
					data-spotlight
				>
					<Image
						src={product.image}
						alt={product.alt}
						class="product-card__image"
						width={1280}
						height={854}
						widths={[480, 768, 1280]}
						sizes="(max-width: 767px) calc(100vw - 40px), (max-width: 1372px) calc((100vw - 120px) / 2), 626px"
						format="webp"
						quality={85}
						loading="lazy"
						decoding="async"
					/>
					<div class="product-card__body">
						<h3>{product.title}</h3>
						<p>{product.summary}</p>
						<dl class="product-card__summary">
							<div>
								<dt>Hasta</dt>
								<dd>
									{product.maxAmount}
									<span class="product-card__currency"> MXN</span>
								</dd>
							</div>
							<div>
								<dt>Plazo</dt>
								<dd>
									{product.term}
									<small>{product.termNote}</small>
								</dd>
							</div>
						</dl>
						<a href={product.href}>
							Conocer el crédito <span aria-hidden="true">→</span>
						</a>
					</div>
				</article>
			))
		}
	</div>
	<p class="solutions__note">Montos y plazos sujetos a evaluación.</p>
</section>
