---
import {
	calculateLoan,
	loanSimulations,
	type LoanProduct,
} from "../lib/loan-simulation";
import { formatCurrencyInput } from "../lib/currency-input";

interface Props {
	product?: LoanProduct;
}
const { product = "personal" } = Astro.props;
const config = loanSimulations[product];
const initial = calculateLoan(product, {
	amount: config.amount.initial,
	termMonths: config.term.initial,
	totalInsurance: config.insurance.initial,
});
const money = (value: number) =>
	new Intl.NumberFormat("es-MX", {
		style: "currency",
		currency: "MXN",
		minimumFractionDigits: 2,
		maximumFractionDigits: 2,
	}).format(value);
const compactMoney = (value: number) =>
	new Intl.NumberFormat("es-MX", {
		style: "currency",
		currency: "MXN",
		minimumFractionDigits: 0,
		maximumFractionDigits: 2,
	}).format(value);
const percent = (value: number) =>
	new Intl.NumberFormat("es-MX", {
		style: "percent",
		maximumFractionDigits: 2,
	}).format(value);
---

<section
	class="loan-calculator"
	id="simulador"
	aria-labelledby="simulator-title"
	data-loan-calculator
	data-loan-product={product}
	style={`--amount-width: ${formatCurrencyInput(config.amount.max).length}ch; --term-count: ${config.term.options.length};`}
>
	<div class="loan-calculator__inner">
		<div class="loan-calculator__panel">
			<div class="loan-calculator__grid">
				<div class="loan-calculator__controls">
					<header class="loan-calculator__heading">
						<h2 id="simulator-title">
							Simula <span>tu crédito</span>
						</h2>
						<p>
							{
								product === "business"
									? "Crédito simple con garantía hipotecaria. Elige el monto y el plazo para conocer tu mensualidad estimada."
									: "Elige el monto y el plazo para conocer tu mensualidad estimada."
							}
						</p>
					</header>

					<form novalidate aria-labelledby="simulator-title">
						<fieldset disabled>
							<legend class="visually-hidden"
								>Datos de la simulación</legend
							>
							<div class="loan-calculator__field">
								<div class="loan-calculator__field-heading">
									<label
										id="simulation-amount-label"
										for="simulation-amount"
										>Monto del crédito</label
									>
									<div class="loan-calculator__number">
										<input
											id="simulation-amount"
											name="amount"
											type="text"
											inputmode="numeric"
											autocomplete="off"
											spellcheck={false}
											value={formatCurrencyInput(
												config.amount.initial,
											)}
											required
											aria-describedby="simulation-amount-hint simulation-amount-error"
										/>
										<span aria-hidden="true">MXN</span>
									</div>
								</div>
								<input
									class="loan-calculator__range"
									id="simulation-amount-range"
									type="range"
									min={config.amount.min}
									max={config.amount.max}
									step="1"
									value={config.amount.initial}
									style={`--range-progress: ${((config.amount.initial - config.amount.min) / (config.amount.max - config.amount.min)) * 100}%`}
									aria-label="Ajustar monto del crédito en pesos mexicanos"
									aria-valuetext={compactMoney(
										config.amount.initial,
									)}
									aria-describedby="simulation-amount-hint simulation-amount-error"
								/>
								<div
									class="loan-calculator__bounds"
									id="simulation-amount-hint"
								>
									<span
										>{compactMoney(config.amount.min)} MXN</span
									><span
										>{compactMoney(config.amount.max)} MXN</span
									>
								</div>
								<p
									class="loan-calculator__error"
									id="simulation-amount-error"
									hidden
								>
								</p>
							</div>

							<fieldset
								class="loan-calculator__field loan-calculator__term"
								id="simulation-term"
								aria-describedby="simulation-eligibility-note simulation-term-error"
							>
								<legend>Plazo</legend>
								<div class="loan-calculator__term-options">
									{
										config.term.options.map((months) => (
											<label class="loan-calculator__term-option">
												<input
													class="visually-hidden"
													type="radio"
													name="term"
													value={months}
													checked={
														months ===
														config.term.initial
													}
													required
													aria-describedby="simulation-eligibility-note simulation-term-error"
												/>
												<span>
													{months}{" "}
													<small>meses</small>
												</span>
											</label>
										))
									}
								</div>
								<p
									class="loan-calculator__error"
									id="simulation-term-error"
									hidden
								>
								</p>
							</fieldset>
							<details class="loan-calculator__optional">
								<summary
									>Ajustar seguro <span>(opcional)</span
									></summary
								>
								<div
									class="loan-calculator__field loan-calculator__field--secondary"
								>
									<label for="simulation-insurance"
										>Seguro total durante el plazo</label
									>
									<div
										class="loan-calculator__number loan-calculator__number--secondary"
									>
										<input
											id="simulation-insurance"
											name="insurance"
											type="text"
											inputmode="numeric"
											autocomplete="off"
											spellcheck={false}
											value={formatCurrencyInput(
												config.insurance.initial,
											)}
											aria-describedby="simulation-insurance-hint simulation-insurance-error"
										/>
										<span aria-hidden="true">MXN</span>
									</div>
									<p
										class="loan-calculator__hint"
										id="simulation-insurance-hint"
									>
										Captura el importe si ya cuentas con una
										referencia. En cero o vacío se excluye
										del cálculo; no significa que sea
										gratuito.
									</p>
									<p
										class="loan-calculator__error"
										id="simulation-insurance-error"
										hidden
									>
									</p>
								</div>
							</details>
						</fieldset>
						<noscript
							><p class="loan-calculator__hint">
								Activa JavaScript para ajustar los datos. El
								resultado mostrado es el ejemplo inicial.
							</p></noscript
						>
					</form>
				</div>

				<div
					class="loan-calculator__result"
					aria-labelledby="simulation-result-title"
				>
					<h3 id="simulation-result-title">Mensualidad estimada</h3>
					<p class="loan-calculator__payment">
						<span data-monthly-payment
							>{money(initial.monthlyPayment)}</span
						>
						<small data-result-currency>MXN</small>
					</p>
					<p
						class="loan-calculator__context"
						data-result-context
						hidden
					>
						Revisa los datos para ver tu mensualidad.
					</p>
					<div data-result-details>
						<div class="loan-calculator__opening">
							<p data-insurance-row hidden>
								Seguro mensual incluido <strong
									data-monthly-insurance></strong>
							</p>
							<p>
								Comisión de apertura con IVA <strong
									data-opening-fee
									>{money(initial.openingFee)}</strong
								>
							</p>
						</div>
					</div>
				</div>
			</div>

			<footer class="loan-calculator__reference">
				<p class="loan-calculator__insurance" data-insurance-note>
					La estimación no incluye seguros. Su aplicación y costo
					están pendientes de confirmación.
				</p>
				<p id="simulation-eligibility-note">
					* Monto y plazo sujetos a evaluación.
				</p>
				<p>
					Supuestos del cálculo: tasa anual del {
						percent(config.annualRate)
					}, apertura del {percent(config.openingFeeRate)} más IVA. Son
					referencias de simulación; la tasa y la comisión definitivas están
					pendientes de publicación.
				</p>
				{
					product === "business" && (
						<p>
							El CAT de la modalidad con garantía hipotecaria está
							pendiente de confirmación.
						</p>
					)
				}
			</footer>
			<p
				class="visually-hidden"
				role="status"
				aria-live="polite"
				aria-atomic="true"
				data-result-status
			>
			</p>
		</div>
	</div>
</section>

<script>
	import { calculateLoan, loanSimulations } from "../lib/loan-simulation";
	import {
		formatCurrencyEdit,
		formatCurrencyInput,
		parseCurrencyInput,
	} from "../lib/currency-input";

	let cleanupLoanCalculator: (() => void) | undefined;

	function initLoanCalculator() {
		const calculator = document.querySelector<HTMLElement>(
			"[data-loan-calculator]",
		);
		const form = calculator?.querySelector("form");
		if (!calculator || !form || form.dataset.initialized) return;
		const product = calculator.dataset.loanProduct;
		if (product !== "personal" && product !== "business") return;
		const config = loanSimulations[product];
		cleanupLoanCalculator?.();
		const controller = new AbortController();
		const { signal } = controller;

		const fieldset = form.querySelector("fieldset")!;
		const amount = form.querySelector<HTMLInputElement>('[name="amount"]')!;
		const insurance =
			form.querySelector<HTMLInputElement>('[name="insurance"]')!;
		const insuranceRow = calculator.querySelector<HTMLElement>(
			"[data-insurance-row]",
		)!;
		const insuranceNote = calculator.querySelector<HTMLElement>(
			"[data-insurance-note]",
		)!;
		const amountRange = form.querySelector<HTMLInputElement>(
			"#simulation-amount-range",
		)!;
		const termField =
			form.querySelector<HTMLFieldSetElement>("#simulation-term")!;
		const termOptions = Array.from(
			termField.querySelectorAll<HTMLInputElement>('[name="term"]'),
		);
		const selectedTerm = () =>
			Number(termOptions.find((option) => option.checked)?.value);
		const insuranceValue = () =>
			insurance.value.trim() === "" || insurance.value.trim() === "$"
				? 0
				: parseCurrencyInput(insurance.value);
		const resultDetails = calculator.querySelector<HTMLElement>(
			"[data-result-details]",
		)!;
		const currency = calculator.querySelector<HTMLElement>(
			"[data-result-currency]",
		)!;
		const context = calculator.querySelector<HTMLElement>(
			"[data-result-context]",
		)!;
		const status = calculator.querySelector<HTMLElement>(
			"[data-result-status]",
		)!;
		const money = new Intl.NumberFormat("es-MX", {
			style: "currency",
			currency: "MXN",
			minimumFractionDigits: 2,
			maximumFractionDigits: 2,
		});
		const compactMoney = new Intl.NumberFormat("es-MX", {
			style: "currency",
			currency: "MXN",
			minimumFractionDigits: 0,
			maximumFractionDigits: 2,
		});
		let announcementTimer: ReturnType<typeof setTimeout>;
		const announce = (message: string) => {
			clearTimeout(announcementTimer);
			announcementTimer = setTimeout(() => {
				if (calculator.isConnected) status.textContent = message;
			}, 400);
		};
		const setText = (selector: string, value: string) => {
			const element = calculator.querySelector<HTMLElement>(selector)!;
			if (element.textContent !== value) element.textContent = value;
		};
		const setError = (
			field: HTMLInputElement | HTMLFieldSetElement,
			message: string,
		) => {
			const error = calculator.querySelector<HTMLElement>(
				`#${field.id}-error`,
			)!;
			error.textContent = message;
			error.hidden = !message;
			if (message) {
				field.setAttribute("aria-invalid", "true");
				const details = field.closest("details");
				if (details) details.open = true;
			} else field.removeAttribute("aria-invalid");
		};
		const updateRange = (
			range: HTMLInputElement,
			value: number,
			text: string,
		) => {
			range.value = String(value);
			const progress =
				((value - Number(range.min)) /
					(Number(range.max) - Number(range.min))) *
				100;
			range.style.setProperty("--range-progress", `${progress}%`);
			range.setAttribute("aria-valuetext", text);
		};
		const validate = (amountValue: number, totalInsurance: number) => [
			amount.value.trim() === "" || amount.value.trim() === "$"
				? "Ingresa el monto del crédito."
				: !Number.isFinite(amountValue)
					? "Ingresa un monto en pesos enteros."
					: amountValue < config.amount.min ||
						  amountValue > config.amount.max
						? `Elige un monto de ${compactMoney.format(config.amount.min)} a ${compactMoney.format(config.amount.max)}.`
						: "",
			config.term.options.some((months) => months === selectedTerm())
				? ""
				: `Elige un plazo de ${new Intl.ListFormat("es-MX", { type: "disjunction" }).format(config.term.options.map(String))} meses.`,
			!Number.isFinite(totalInsurance) || totalInsurance < 0
				? "Ingresa un seguro en pesos enteros, igual o mayor que cero."
				: totalInsurance > config.insurance.max
					? `El seguro no puede superar ${compactMoney.format(config.insurance.max)}.`
					: "",
		];
		const update = (showErrors = false, announceResult = true) => {
			const amountValue = parseCurrencyInput(amount.value);
			const totalInsurance = insuranceValue();
			const errors = validate(amountValue, totalInsurance);
			[amount, termField, insurance].forEach((field, index) => {
				if (
					showErrors ||
					!errors[index] ||
					field.hasAttribute("aria-invalid")
				)
					setError(field, errors[index]);
			});
			if (!errors[0])
				updateRange(
					amountRange,
					amountValue,
					compactMoney.format(amountValue),
				);
			const invalid = errors.some(Boolean);
			resultDetails.hidden = invalid;
			currency.hidden = invalid;
			context.hidden = !invalid;
			insuranceNote.hidden = invalid;
			if (invalid) {
				setText("[data-monthly-payment]", "—");
				if (announceResult)
					announce("Revisa los datos para ver tu mensualidad.");
				return;
			}

			const estimate = calculateLoan(product, {
				amount: amountValue,
				termMonths: selectedTerm(),
				totalInsurance,
			});
			setText(
				"[data-monthly-payment]",
				money.format(estimate.monthlyPayment),
			);
			setText("[data-opening-fee]", money.format(estimate.openingFee));
			insuranceRow.hidden = totalInsurance === 0;
			setText(
				"[data-monthly-insurance]",
				money.format(estimate.monthlyInsurance),
			);
			insuranceNote.textContent =
				totalInsurance > 0
					? `Seguro total considerado: ${money.format(totalInsurance)}, distribuido durante los ${selectedTerm()} meses del plazo. La mensualidad lo incluye; su costo definitivo está pendiente de confirmación.`
					: "La estimación no incluye seguros. Su aplicación y costo están pendientes de confirmación.";
			if (announceResult)
				announce(
					`Mensualidad estimada: ${money.format(estimate.monthlyPayment)}. Apertura por separado: ${money.format(estimate.openingFee)}.`,
				);
		};

		const bindCurrencyField = (field: HTMLInputElement) => {
			const formatEditingField = () => {
				const formatted = formatCurrencyEdit(
					field.value,
					field.selectionStart ?? field.value.length,
					field.selectionEnd ?? field.value.length,
				);
				if (formatted && formatted.text !== field.value) {
					const direction = field.selectionDirection ?? "none";
					field.value = formatted.text;
					field.setSelectionRange(
						formatted.selectionStart,
						formatted.selectionEnd,
						direction,
					);
				}
				update();
			};
			field.addEventListener(
				"beforeinput",
				(event) => {
					if (event.isComposing) return;
					const start = field.selectionStart ?? 0;
					const end = field.selectionEnd ?? start;
					if (
						start === 0 &&
						end === 0 &&
						field.value.startsWith("$") &&
						event.inputType === "insertText" &&
						event.data !== null
					) {
						event.preventDefault();
						if (
							formatCurrencyEdit(
								`$${event.data}${field.value.slice(1)}`,
							)
						) {
							field.setRangeText(event.data, 1, 1, "end");
							formatEditingField();
						}
						return;
					}
					if (
						event.inputType === "insertText" &&
						event.data !== null
					) {
						const next =
							field.value.slice(0, start) +
							event.data +
							field.value.slice(end);
						if (!formatCurrencyEdit(next)) event.preventDefault();
					}
					// Delete the neighboring digit as well when Backspace/Delete crosses a comma.
					if (
						start === end &&
						event.inputType === "deleteContentBackward" &&
						field.value[start - 1] === ","
					) {
						event.preventDefault();
						field.setRangeText("", start - 2, start, "end");
						formatEditingField();
					} else if (
						start === end &&
						event.inputType === "deleteContentForward" &&
						field.value[start] === ","
					) {
						event.preventDefault();
						field.setRangeText("", start, start + 2, "start");
						formatEditingField();
					}
				},
				{ signal },
			);
			field.addEventListener(
				"input",
				(event) => {
					if (!(event instanceof InputEvent) || !event.isComposing)
						formatEditingField();
				},
				{ signal },
			);
			field.addEventListener("compositionend", formatEditingField, {
				signal,
			});
			field.addEventListener(
				"blur",
				() => {
					const value =
						field === insurance
							? insuranceValue()
							: parseCurrencyInput(field.value);
					if (Number.isFinite(value))
						field.value = formatCurrencyInput(value);
					update(true);
				},
				{ signal },
			);
		};
		bindCurrencyField(amount);
		bindCurrencyField(insurance);
		amountRange.addEventListener(
			"input",
			() => {
				// Use practical drag increments while retaining exact whole-peso input.
				amount.value = formatCurrencyInput(
					amountRange.matches(":active")
						? Math.round(
								amountRange.valueAsNumber /
									config.amount.dragStep,
							) * config.amount.dragStep
						: amountRange.valueAsNumber,
				);
				update();
			},
			{ signal },
		);
		amountRange.addEventListener(
			"keydown",
			(event) => {
				const increments: Record<string, number> = {
					ArrowRight: config.amount.dragStep,
					ArrowUp: config.amount.dragStep,
					ArrowLeft: -config.amount.dragStep,
					ArrowDown: -config.amount.dragStep,
					PageUp: config.amount.pageStep,
					PageDown: -config.amount.pageStep,
				};
				if (!(event.key in increments)) return;
				event.preventDefault();
				const next = amountRange.valueAsNumber + increments[event.key];
				amount.value = formatCurrencyInput(
					Math.min(
						config.amount.max,
						Math.max(config.amount.min, next),
					),
				);
				update();
			},
			{ signal },
		);
		termOptions.forEach((option) =>
			option.addEventListener("change", () => update(), { signal }),
		);
		form.addEventListener(
			"submit",
			(event) => {
				event.preventDefault();
				update(true);
				if (amount.hasAttribute("aria-invalid")) amount.focus();
				else if (termField.hasAttribute("aria-invalid"))
					termOptions[0]?.focus();
				else if (insurance.hasAttribute("aria-invalid")) {
					insurance.closest("details")!.open = true;
					insurance.focus();
				}
			},
			{ signal },
		);
		form.addEventListener(
			"keydown",
			(event) => {
				if (
					event.key === "Enter" &&
					!event.isComposing &&
					event.target instanceof HTMLInputElement &&
					event.target.type === "text"
				) {
					event.preventDefault();
					form.requestSubmit();
				}
			},
			{ signal },
		);

		form.dataset.initialized = "true";
		cleanupLoanCalculator = () => {
			controller.abort();
			clearTimeout(announcementTimer);
			delete form.dataset.initialized;
			cleanupLoanCalculator = undefined;
		};
		fieldset.disabled = false;
		update(false, false);
	}

	initLoanCalculator();
	document.addEventListener("astro:page-load", initLoanCalculator);
	document.addEventListener("astro:before-swap", () =>
		cleanupLoanCalculator?.(),
	);
</script>

<style>
	.loan-calculator {
		padding: 2rem 0 5.5rem;
		scroll-margin-top: 7rem;
	}
	.loan-calculator__inner {
		width: min(calc(100% - 6rem), 79.75rem);
		margin-inline: auto;
	}
	.loan-calculator__panel {
		padding: clamp(2rem, 3vw, 2.5rem);
		border-radius: 1rem;
		background: #f4f4f3;
	}
	.loan-calculator__heading {
		margin-bottom: 2rem;
	}
	h2 {
		font-size: 2rem;
		font-weight: 700;
		line-height: 1.2;
		letter-spacing: -0.0375rem;
		color: #000;
	}
	h2 span {
		color: var(--color-primary);
	}
	.loan-calculator__heading > p {
		margin-top: 1rem;
		font-size: 1rem;
		line-height: 1.6;
		color: var(--color-muted);
	}
	.loan-calculator__grid {
		display: grid;
		grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
		align-items: center;
		gap: clamp(2rem, 4vw, 3.5rem);
	}
	.loan-calculator__controls {
		min-width: 0;
	}
	form,
	fieldset {
		min-width: 0;
	}
	fieldset {
		margin: 0;
		padding: 0;
		border: 0;
	}
	.loan-calculator__field + .loan-calculator__field {
		margin-top: 2rem;
	}
	.loan-calculator__field-heading {
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 0.5rem 1rem;
	}
	label {
		font-size: 1rem;
		font-weight: 500;
		line-height: 1.4;
	}
	.loan-calculator__number {
		display: flex;
		align-items: center;
		justify-content: flex-end;
		gap: 0.375rem;
		width: auto;
		max-width: 100%;
		margin-left: auto;
		padding: 0.625rem 0;
		border: 1px solid transparent;
		border-radius: 0.5rem;
		background: transparent;
	}
	.loan-calculator__number > span {
		font-size: 0.875rem;
		color: #696967;
	}
	.loan-calculator__optional {
		margin-top: 1.75rem;
	}
	.loan-calculator__optional summary {
		width: fit-content;
		min-height: 2.75rem;
		padding-block: 0.625rem;
