---
import uploadIcon from "../assets/factoraje/sube-factura.svg";
import approvalIcon from "../assets/factoraje/aprobacion-rapida.svg";
import advanceIcon from "../assets/factoraje/anticipo-capital.svg";
import collectionIcon from "../assets/factoraje/cobranza.svg";

const steps = [
	{
		title: "1. Conversemos",
		description:
			"Cuéntanos qué necesita tu empresa. Un asesor te indicará cómo compartir las facturas y documentación al iniciar el trámite.",
		icon: uploadIcon,
	},
	{
		title: "2. Evaluamos la Operación",
		description:
			"Revisamos la elegibilidad de los documentos y a los obligados al pago antes de estructurar una propuesta.",
		icon: approvalIcon,
	},
	{
		title: "3. Anticipo de Capital",
		description:
			"Una vez autorizada y formalizada la operación, recibes el porcentaje de anticipo acordado, descontando los cargos aplicables.",
		icon: advanceIcon,
	},
	{
		title: "4. Cobranza",
		description:
			"El cobro y la liberación de la reserva se realizan conforme al cumplimiento del pagador y a los términos del contrato.",
		icon: collectionIcon,
	},
];
---

<section class="factoring-process" aria-labelledby="factoring-process-title">
	<header class="factoring-section-heading" data-page-reveal>
		<h2 id="factoring-process-title">
			El Proceso de <span>Factoraje</span>
		</h2>
		<p>
			Una propuesta basada en tus cuentas por cobrar y en el ciclo de tu
			operación, sujeta a evaluación.
		</p>
	</header>
	<ol class="factoring-process__grid" data-page-reveal-group>
		{
			steps.map((step) => (
				<li class="factoring-process__card" data-page-reveal>
					<img src={step.icon.src} alt="" width="112" height="114" />
					<h3>{step.title}</h3>
					<p>{step.description}</p>
				</li>
			))
		}
	</ol>
</section>
