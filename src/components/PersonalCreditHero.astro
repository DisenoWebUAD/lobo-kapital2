---
import { Picture } from "astro:assets";
import "../styles/credit-heroes.css";
import heroImage from "../assets/personal-credit/hero.jpg";
---

<section
	class="credit-hero personal-hero"
	id="inicio"
	aria-labelledby="personal-hero-title"
>
	<div class="credit-hero__inner personal-hero__inner">
		<div class="credit-hero__copy personal-hero__copy">
			<h1 id="personal-hero-title">
				<span>Libertad Financiera</span>
				<span class="credit-hero__muted personal-hero__muted"
					>con Beneficios</span
				>
				<span>Exclusivos</span>
			</h1>
			<p>
				Diseñadas para adaptarse a tu estilo de vida y potenciar el
				crecimiento de tu negocio. Seguridad institucional, recompensas
				excepcionales y aceptación global.
			</p>
			<div class="credit-hero__actions personal-hero__actions">
				<a class="button button--primary" href="#contacto"
					>Solicitar ahora <span aria-hidden="true">→</span></a
				>
				<a class="button button--outline" href="#beneficios"
					>Conoce los beneficios</a
				>
			</div>
		</div>

		<div class="credit-hero__visual personal-hero__visual">
			<Picture
				src={heroImage}
				formats={["avif", "webp"]}
				widths={[420, 646]}
				sizes="(max-width: 29.9375em) calc(100vw - 2.5rem), (max-width: 56.1875em) min(37.5rem, calc(100vw - clamp(2.5rem, 8vw, 4rem))), min(33.85vw, 40.625rem)"
				alt="Mujer mostrando una tarjeta de crédito Lobo Kapital"
				class="credit-hero__image personal-hero__image"
				loading="eager"
				fetchpriority="high"
			/>
		</div>
	</div>
</section>
