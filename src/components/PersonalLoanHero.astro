---
import { Picture } from "astro:assets";
import "../styles/credit-heroes.css";
import heroImage from "../assets/home/hero.jpg";
import { credits } from "../data/credits";

const product = credits.personal;
// Account for the landscape source being cropped to a tall frame.
const imageSizes =
	"(max-width: 479px) calc(240vw - 96px), (max-width: 899px) 1060px, (max-width: 1919px) 92.5vw, 1780px";
---

<section
	class="credit-hero personal-loan-hero"
	id="inicio"
	aria-labelledby="personal-loan-title"
>
	<div class="credit-hero__inner personal-loan-hero__inner">
		<div class="credit-hero__copy personal-loan-hero__copy">
			<h1 id="personal-loan-title">
				<span>Crédito personal</span>{" "}<span>para tus planes</span>
			</h1>
			<p class="personal-loan-hero__summary">{product.summary}</p>

			<div class="credit-hero__actions personal-loan-hero__actions">
				<a class="button button--primary" href="#contacto"
					>Pedir información <span aria-hidden="true">→</span></a
				>
				<a class="button button--outline" href="#simulador"
					>Simula tu crédito</a
				>
			</div>
		</div>

		<div class="credit-hero__visual personal-loan-hero__visual">
			<Picture
				src={heroImage}
				formats={["avif", "webp"]}
				widths={[640, 960, 1280, 1920, 2400]}
				sizes={imageSizes}
				alt="Mujer en un espacio de trabajo con una computadora portátil"
				class="credit-hero__image personal-loan-hero__image"
				loading="eager"
				fetchpriority="high"
			/>
		</div>
	</div>
</section>
