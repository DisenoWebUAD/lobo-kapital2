---
import { Picture } from "astro:assets";
import heroImage from "../assets/home/hero.jpg";
import { credits } from "../data/credits";

const product = credits.personal;
// Account for the landscape source being cropped to a tall frame.
const imageSizes =
	"(max-width: 767px) calc(190vw - 76px), (max-width: 1023px) 800px, (max-width: 1372px) 90vw, 1180px";
---

<section
	class="personal-loan-hero"
	id="inicio"
	aria-labelledby="personal-loan-title"
>
	<div class="personal-loan-hero__inner">
		<div class="personal-loan-hero__copy">
			<h1 id="personal-loan-title">
				<span>Crédito personal</span>{" "}<span>para tus planes</span>
			</h1>
			<p class="personal-loan-hero__summary">{product.summary}</p>

			<div class="personal-loan-hero__actions">
				<a class="button button--primary" href="#contacto"
					>Pedir información <span aria-hidden="true">→</span></a
				>
				<a class="button button--outline" href="#simulador"
					>Simula tu crédito</a
				>
			</div>
		</div>

		<div class="personal-loan-hero__visual">
			<Picture
				src={heroImage}
				formats={["avif", "webp"]}
				widths={[640, 960, 1280, 1920, 2400]}
				sizes={imageSizes}
				alt="Mujer en un espacio de trabajo con una computadora portátil"
				class="personal-loan-hero__image"
				loading="eager"
				fetchpriority="high"
			/>
		</div>
	</div>
</section>

<style>
	.personal-loan-hero {
		padding: 170px 0 80px;
		background: var(--color-white);
	}

	.personal-loan-hero__inner {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 0.95fr);
		gap: clamp(48px, 6vw, 80px);
		align-items: center;
		width: min(calc(100% - 96px), 1276px);
		margin-inline: auto;
	}

	.personal-loan-hero__copy {
		min-width: 0;
	}

	.personal-loan-hero__eyebrow {
		margin-bottom: 20px;
		font-size: 14px;
		font-weight: 600;
		line-height: 1.4;
		color: var(--color-muted);
	}

	h1 {
		font-size: 64px;
		font-weight: 700;
		line-height: 68px;
		letter-spacing: -1.4px;
		color: var(--color-text);
	}

	h1 > span {
		display: block;
	}

	h1 > span:first-child {
		color: var(--color-primary);
	}

	.personal-loan-hero__summary {
		max-width: 37ch;
		margin-top: 24px;
		font-size: 20px;
		line-height: 1.45;
		color: var(--color-muted);
	}

	.personal-loan-hero__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 16px;
		margin-top: 32px;
	}

	.personal-loan-hero__visual {
		width: 100%;
		max-width: 560px;
		aspect-ratio: 0.9;
		justify-self: end;
		overflow: hidden;
		border-radius: 76px 76px 58px 58px;
	}

	.personal-loan-hero__image {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
	}

	@media (max-width: 1199px) {
		h1 {
			font-size: 56px;
			line-height: 60px;
		}
	}

	@media (max-width: 1023px) {
		.personal-loan-hero__inner {
			grid-template-columns: minmax(0, 1fr);
			gap: 48px;
			width: min(calc(100% - 64px), 720px);
		}

		.personal-loan-hero__visual {
			aspect-ratio: 4 / 3;
			justify-self: center;
			border-radius: 56px;
		}
	}

	@media (max-width: 767px) {
		.personal-loan-hero {
			padding: 140px 0 48px;
		}

		.personal-loan-hero__inner {
			gap: 40px;
			width: calc(100% - 40px);
		}

		.personal-loan-hero__eyebrow {
			margin-bottom: 16px;
		}

		h1 {
			font-size: 40px;
			line-height: 44px;
			letter-spacing: -0.8px;
		}

		.personal-loan-hero__summary {
			margin-top: 20px;
			font-size: 18px;
		}

		.personal-loan-hero__actions {
			margin-top: 28px;
		}

		.personal-loan-hero__visual {
			aspect-ratio: 1;
			border-radius: 40px;
		}
	}
</style>
