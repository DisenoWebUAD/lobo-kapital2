---
import logoWordmark from "../assets/home/logo-wordmark.svg";
import { cardsEnabled } from "../data/cards";

const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
const isPersonalPage = pathname === "/credito-personal";
const isCardsPage = pathname === "/tarjetas";
const isPersonalSection = isPersonalPage || isCardsPage;
const isPymesPage = pathname === "/creditos-pymes";
const isRevolvingPage = pathname === "/credito-en-cuenta-corriente";
const isLeasePage = pathname === "/arrendamiento";
const isFinanceLeasePage = pathname === "/arrendamiento-financiero";
const isFactoringPage = Astro.url.pathname.startsWith("/factoraje");
const isFaqPage = Astro.url.pathname.startsWith("/faq");
const isAboutPage = Astro.url.pathname.startsWith("/nosotros");
const isPymesSection =
	isPymesPage ||
	isRevolvingPage ||
	isLeasePage ||
	isFinanceLeasePage ||
	isFactoringPage;
const hasContactSection =
	Astro.url.pathname === "/" || isPersonalPage || (isCardsPage && cardsEnabled) || isFactoringPage;
const clientHref =
	isPymesPage || isRevolvingPage || isLeasePage || isFinanceLeasePage
		? "#solicitud"
		: hasContactSection
			? "#contacto"
			: "/#contacto";
---

<header
	class="site-header"
	aria-label="Encabezado principal"
	transition:name="site-header"
	transition:animate="none"
>
	<a
		class="site-header__brand"
		href="/"
		aria-label="Lobo Kapital, ir al inicio"
	>
		<img
			src={logoWordmark.src}
			alt="Lobo Kapital"
			width="187"
			height="19"
		/>
	</a>

	<nav
		class="site-nav"
		id="site-navigation"
		aria-label="Navegación principal"
	>
		<div
			class="site-nav__pymes"
			data-nav-dropdown
			data-active={isPymesSection ? "" : undefined}
		>
			<button
				class="site-nav__pymes-trigger"
				type="button"
				aria-controls="pymes-navigation"
				aria-expanded="false"
				aria-current={isPymesSection ? "page" : undefined}
			>
				PyMEs
			</button>
			<div
				class="site-nav__pymes-menu site-nav__pymes-menu--business"
				id="pymes-navigation"
				aria-label="Soluciones para PyMEs"
				aria-hidden="true"
			>
				<div class="site-nav__products">
					<a
						href="/creditos-pymes/"
						aria-current={isPymesPage ? "page" : undefined}
						>Crédito simple</a
					>
					<a
						href="/credito-en-cuenta-corriente/"
						aria-current={isRevolvingPage ? "page" : undefined}
						>Crédito en cuenta corriente</a
					>
					<a
						href="/arrendamiento-financiero/"
						aria-current={isFinanceLeasePage ? "page" : undefined}
						>Arrendamiento financiero</a
					>
					<a
						href="/arrendamiento/"
						aria-current={isLeasePage ? "page" : undefined}
						>Arrendamiento puro</a
					>
					<a
						href="/factoraje/"
						aria-current={isFactoringPage ? "page" : undefined}
						>Factoraje</a
					>
				</div>
				<a class="site-nav__guide" href="/#elige-tu-financiamiento">
					<strong>Ayúdame a elegir</strong>
					<small>Explora opciones para tu negocio</small>
				</a>
			</div>
		</div>
		<div
			class="site-nav__pymes"
			data-nav-dropdown
			data-active={isPersonalSection ? "" : undefined}
		>
			<button
				class="site-nav__pymes-trigger"
				type="button"
				aria-controls="personal-navigation"
				aria-expanded="false"
				aria-current={isPersonalSection ? "page" : undefined}
			>
				Personas
			</button>
			<div
				class="site-nav__pymes-menu"
				id="personal-navigation"
				aria-label="Productos para personas"
				aria-hidden="true"
			>
				<a
					href="/credito-personal/"
					aria-current={isPersonalPage ? "page" : undefined}
					>Crédito personal</a
				>
				{cardsEnabled ? (
					<a href="/tarjetas/" aria-current={isCardsPage ? "page" : undefined}>Tarjetas</a>
				) : (
					<span class="site-nav__disabled" role="link" aria-disabled="true">TDC (próximamente)</span>
				)}
			</div>
		</div>
		<a
			class="site-nav__section-link"
			href={pathname === "/" ? "#proceso" : "/#proceso"}>Cómo funciona</a
		>
		<a
			class="site-nav__section-link"
			href="/nosotros/"
			aria-current={isAboutPage ? "page" : undefined}>Conócenos</a
		>
		<a
			class="site-nav__faq"
			href="/faq/"
			aria-label="Preguntas frecuentes"
			aria-current={isFaqPage ? "page" : undefined}>FAQ</a
		>
		<a class="site-nav__client" href={clientHref}>Contáctanos</a>
	</nav>

	<button
		class="menu-toggle"
		type="button"
		aria-expanded="false"
		aria-controls="site-navigation"
		aria-label="Abrir menú"
	>
		<span></span>
		<span></span>
		<span></span>
	</button>
</header>

<script>
	let headerController: AbortController | undefined;

	const disposeHeader = () => {
		headerController?.abort();
		headerController = undefined;
	};

	const initializeHeader = () => {
		disposeHeader();
		const header = document.querySelector<HTMLElement>(".site-header");
		if (!header) return;
		headerController = new AbortController();
		const { signal } = headerController;
		const menuButton =
			document.querySelector<HTMLButtonElement>(".menu-toggle");
		const navigation =
			document.querySelector<HTMLElement>("#site-navigation");
		const desktopNavigation = window.matchMedia("(min-width: 75em)");
		const dropdowns = Array.from(
			document.querySelectorAll<HTMLElement>("[data-nav-dropdown]"),
		).map((group) => ({
			group,
			trigger: group.querySelector<HTMLButtonElement>(
				".site-nav__pymes-trigger",
			),
			menu: group.querySelector<HTMLElement>(".site-nav__pymes-menu"),
			openedByHover: false,
			closeTimer: undefined as number | undefined,
		}));

		const isHomePage = document.body.dataset.page === "home";
		const hideScrollTolerance = 8;
		const mobileRevealScrollTolerance = 32;
		let viewportWidth = window.innerWidth;
		let scrollFrame: number | undefined;
		let measureOnNextFrame = false;
		let scrollThreshold = 0;
		let direction = 0;
		let directionalDistance = 0;
		// Clamp Safari's rubber-band positions before detecting direction.
		const getScrollY = (scrollY = window.scrollY) =>
			Math.max(
				0,
				Math.min(
					scrollY,
					Math.max(
						0,
						document.documentElement.scrollHeight -
							window.innerHeight,
					),
				),
			);
		let lastScrollY = getScrollY();
		const restoredScrollY: unknown = history.state?.scrollY;
		// Astro's history restoration can still be scrolling when page-load fires.
		let restoringScroll =
			typeof restoredScrollY === "number" &&
			Math.abs(lastScrollY - getScrollY(restoredScrollY)) > 1;
		const updateHeaderSurface = (scrollY: number) => {
			header.toggleAttribute("data-scrolled", isHomePage && scrollY > 24);
		};
		const resetScrollTracking = () => {
			lastScrollY = getScrollY();
			direction = 0;
			directionalDistance = 0;
			header.removeAttribute("data-scroll-hidden");
			updateHeaderSurface(lastScrollY);
		};
		const finishScrollRestoration = () => {
			if (!restoringScroll) return;
			restoringScroll = false;
			resetScrollTracking();
		};
		const measureHeader = () => {
			scrollThreshold =
				header.offsetHeight + parseFloat(getComputedStyle(header).top);
		};
		const navigationIsEngaged = () =>
			navigation?.hasAttribute("data-open") ||
			dropdowns.some(({ group }) => group.hasAttribute("data-open")) ||
			header.querySelector(":focus-visible") !== null;
		const updateScroll = () => {
			scrollFrame = undefined;
			if (measureOnNextFrame) {
				measureOnNextFrame = false;
				measureHeader();
				if (viewportWidth !== window.innerWidth) {
					viewportWidth = window.innerWidth;
					resetScrollTracking();
					return;
				}
				// Browser chrome can resize a mobile viewport without an upward gesture.
				lastScrollY = getScrollY();
			}
			const scrollY = getScrollY();
			const delta = scrollY - lastScrollY;
			lastScrollY = scrollY;
			updateHeaderSurface(scrollY);
			if (restoringScroll) {
				if (
					typeof restoredScrollY === "number" &&
					Math.abs(scrollY - getScrollY(restoredScrollY)) <= 1
				)
					restoringScroll = false;
				resetScrollTracking();
				return;
			}
			if (scrollY <= scrollThreshold || navigationIsEngaged()) {
				direction = 0;
				directionalDistance = 0;
				header.removeAttribute("data-scroll-hidden");
				return;
			}
			if (delta === 0) return;
			const nextDirection = Math.sign(delta);
			if (nextDirection !== direction) {
				direction = nextDirection;
				directionalDistance = 0;
			}
			// Require a deliberate upward movement on the compact navigation.
			const scrollTolerance = direction < 0 && !desktopNavigation.matches
				? mobileRevealScrollTolerance
				: hideScrollTolerance;
			directionalDistance = Math.min(
				scrollTolerance,
				directionalDistance + Math.abs(delta),
			);
			if (directionalDistance >= scrollTolerance) {
				const shouldHide = direction > 0;
				if (header.hasAttribute("data-scroll-hidden") !== shouldHide)
					header.toggleAttribute("data-scroll-hidden", shouldHide);
			}
		};
		const scheduleScrollUpdate = () => {
			if (scrollFrame === undefined)
				scrollFrame = window.requestAnimationFrame(updateScroll);
		};
		// A bfcache restore may reuse a header that was hidden on departure.
		const previousTransition = header.style.transition;
		header.style.transition = "none";
		resetScrollTracking();
		measureHeader();
		if (previousTransition) header.style.transition = previousTransition;
		else header.style.removeProperty("transition");
		window.addEventListener("scroll", scheduleScrollUpdate, {
			passive: true,
			signal,
		});
		window.addEventListener("scrollend", finishScrollRestoration, {
			signal,
		});
		window.addEventListener("wheel", finishScrollRestoration, {
			passive: true,
			signal,
		});
		window.addEventListener(
			"resize",
			() => {
				measureOnNextFrame = true;
				scheduleScrollUpdate();
			},
			{ passive: true, signal },
		);
		header.addEventListener("focusin", resetScrollTracking, { signal });
		// Releasing touch focus must not reveal a header hidden by scrolling.
		header.addEventListener("focusout", scheduleScrollUpdate, { signal });

		const setDropdownOpen = (
			dropdown: (typeof dropdowns)[number],
			isOpen: boolean,
			openedByHover = false,
		) => {
			window.clearTimeout(dropdown.closeTimer);
			const wasOpen = dropdown.group.hasAttribute("data-open");
			dropdown.openedByHover = isOpen && openedByHover;
			dropdown.group.toggleAttribute("data-open", isOpen);
			dropdown.trigger?.setAttribute("aria-expanded", String(isOpen));
			dropdown.menu?.setAttribute("aria-hidden", String(!isOpen));
			if (wasOpen !== isOpen) resetScrollTracking();
		};
		const closeDropdowns = () =>
			dropdowns.forEach((dropdown) => setDropdownOpen(dropdown, false));
		const openDropdown = (
			dropdown: (typeof dropdowns)[number],
			openedByHover = false,
		) => {
			dropdowns.forEach((other) =>
				setDropdownOpen(other, other === dropdown, openedByHover),
			);
		};
		const scheduleDropdownClose = (
			dropdown: (typeof dropdowns)[number],
		) => {
			window.clearTimeout(dropdown.closeTimer);
			dropdown.closeTimer = window.setTimeout(
				() => setDropdownOpen(dropdown, false),
				140,
			);
		};
		signal.addEventListener(
			"abort",
			() => {
				if (scrollFrame !== undefined)
					window.cancelAnimationFrame(scrollFrame);
				dropdowns.forEach((dropdown) =>
					window.clearTimeout(dropdown.closeTimer),
				);
			},
			{ once: true },
		);

		const closeMenu = () => {
			if (!menuButton || !navigation) return;
			menuButton.setAttribute("aria-expanded", "false");
			menuButton.setAttribute("aria-label", "Abrir menú");
			navigation.removeAttribute("data-open");
			closeDropdowns();
			resetScrollTracking();
		};
		desktopNavigation.addEventListener("change", closeMenu, { signal });

		menuButton?.addEventListener(
			"click",
			() => {
				if (!navigation) return;
				const willOpen =
					menuButton.getAttribute("aria-expanded") !== "true";
				menuButton.setAttribute("aria-expanded", String(willOpen));
				menuButton.setAttribute(
					"aria-label",
					willOpen ? "Cerrar menú" : "Abrir menú",
				);
				navigation.toggleAttribute("data-open", willOpen);
				if (!willOpen) closeDropdowns();
				resetScrollTracking();
			},
			{ signal },
		);

		navigation
			?.querySelectorAll("a")
			.forEach((link) =>
				link.addEventListener("click", closeMenu, { signal }),
			);
		dropdowns.forEach((dropdown) => {
			dropdown.trigger?.addEventListener(
				"click",
				(event) => {
					// A first mouse click keeps a menu opened by hover available.
					if (
						dropdown.trigger?.getAttribute("aria-expanded") ===
							"true" &&
						(!desktopNavigation.matches ||
							!dropdown.openedByHover ||
							event.detail === 0)
					)
						setDropdownOpen(dropdown, false);
					else openDropdown(dropdown);
				},
				{ signal },
			);
			dropdown.trigger?.addEventListener(
				"keydown",
				(event) => {
					if (event.key !== "ArrowDown" && event.key !== "ArrowUp")
						return;
					event.preventDefault();
					openDropdown(dropdown);
					const links =
						dropdown.menu?.querySelectorAll<HTMLAnchorElement>("a");
					links?.[
						event.key === "ArrowDown" ? 0 : links.length - 1
					]?.focus();
				},
				{ signal },
			);
			dropdown.group.addEventListener(
				"pointerenter",
				(event) => {
					// Touch also emits pointerenter before click, without hovering.
					window.clearTimeout(dropdown.closeTimer);
					if (event.pointerType !== "mouse") {
						dropdown.openedByHover = false;
						return;
					}
					if (
						desktopNavigation.matches &&
						!dropdown.group.hasAttribute("data-open")
					)
						openDropdown(dropdown, true);
				},
				{ signal },
			);
			dropdown.group.addEventListener(
				"pointerleave",
				(event) => {
					if (
						desktopNavigation.matches &&
						event.pointerType === "mouse" &&
						!dropdown.group.contains(document.activeElement)
					)
						scheduleDropdownClose(dropdown);
				},
				{ signal },
			);
			dropdown.group.addEventListener(
				"focusin",
				() => window.clearTimeout(dropdown.closeTimer),
				{ signal },
			);
			dropdown.group.addEventListener(
				"focusout",
				(event) => {
					if (
						!dropdown.group.contains(
							event.relatedTarget as Node | null,
						)
					)
						scheduleDropdownClose(dropdown);
				},
				{ signal },
			);
		});

		document.addEventListener(
			"pointerdown",
			(event) => {
				finishScrollRestoration();
				dropdowns.forEach((dropdown) => {
					if (!dropdown.group.contains(event.target as Node))
						setDropdownOpen(dropdown, false);
				});
			},
			{ signal },
		);
		document.addEventListener(
			"keydown",
			(event) => {
				finishScrollRestoration();
				if (event.key !== "Escape") return;
				const activeDropdown = dropdowns.find(
					(dropdown) =>
						dropdown.trigger?.getAttribute("aria-expanded") ===
						"true",
				);
				if (activeDropdown) {
					setDropdownOpen(activeDropdown, false);
					activeDropdown.trigger?.focus();
					return;
				}
				if (menuButton?.getAttribute("aria-expanded") === "true") {
					closeMenu();
					menuButton.focus();
				}
			},
			{ signal },
		);
	};

	document.addEventListener("astro:page-load", initializeHeader);
	document.addEventListener("astro:before-swap", disposeHeader);
	window.addEventListener("pagehide", disposeHeader);
	window.addEventListener("pageshow", (event) => {
		if (event.persisted) initializeHeader();
	});
</script>
