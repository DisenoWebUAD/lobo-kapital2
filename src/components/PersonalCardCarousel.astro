---
import { Image } from 'astro:assets';
import classicCard from '../assets/personal-credit/tarjeta-clasica.png';

const slides = [
	{ id: 'future-one', title: 'Próximamente', available: false },
	{ id: 'classic', title: 'Clasica', available: true },
	{ id: 'future-two', title: 'Próximamente', available: false },
];
---

<section class="personal-cards" id="tarjetas" aria-labelledby="personal-cards-title">
	<div class="personal-cards__heading">
		<p>Tarjeta de Crédito Empresarial</p>
		<h2 id="personal-cards-title">Una <span>Tarjeta</span> para Cada Perfil</h2>
		<div>Soluciones de crédito estructuradas para brindar liquidez, control y recompensas adaptadas<br class="personal-cards__desktop-break" /> a tus necesidades corporativas o personales.</div>
	</div>

	<div class="card-carousel" data-card-carousel aria-roledescription="carrusel">
		<div class="card-carousel__viewport" aria-live="polite">
			{slides.map((slide, index) => (
				<article
					class:list={['card-slide', !slide.available && 'card-slide--placeholder']}
					data-card-slide
					data-index={index}
					hidden={index !== 1}
					aria-label={`${index + 1} de ${slides.length}: ${slide.title}`}
				>
					{slide.available ? (
						<>
							<div class="card-slide__copy">
								<h3>Clasica</h3>
								<ul>
									<li>Ideal para construir historial crediticio y manejar<br class="personal-cards__desktop-break" /> gastos diarios con total seguridad.</li>
									<li>Línea de crédito desde $10,000 MXN</li>
									<li>Anualidad sin costo el primer año</li>
									<li>1% Cash Back en todas las compras</li>
								</ul>
							</div>
							<div class="card-slide__visual">
								<Image src={classicCard} alt="Tarjeta de crédito Clásica Lobo Kapital sobre pedestal" width={751} height={766} loading="eager" />
							</div>
						</>
					) : (
						<>
							<div class="card-slide__copy card-slide__copy--placeholder">
								<p class="card-slide__soon">Nueva tarjeta</p>
								<h3>Próximamente</h3>
								<p>Estamos preparando una nueva opción para ampliar los beneficios de tu crédito.</p>
							</div>
							<div class="card-placeholder" aria-hidden="true">
								<span class="card-placeholder__mark">LK</span>
								<span>PRÓXIMAMENTE</span>
							</div>
						</>
					)}
				</article>
			))}
		</div>

		<div class="card-carousel__dots" role="tablist" aria-label="Seleccionar tarjeta">
			{slides.map((slide, index) => (
				<button
					type="button"
					role="tab"
					data-card-dot
					data-index={index}
					aria-label={`Mostrar tarjeta ${index + 1}: ${slide.title}`}
					aria-selected={index === 1 ? 'true' : 'false'}
					tabindex={index === 1 ? 0 : -1}
				></button>
			))}
		</div>
	</div>
</section>

<script>
	document.querySelectorAll<HTMLElement>('[data-card-carousel]').forEach((carousel) => {
		const slides = [...carousel.querySelectorAll<HTMLElement>('[data-card-slide]')];
		const dots = [...carousel.querySelectorAll<HTMLButtonElement>('[data-card-dot]')];
		let activeIndex = 1;
		let pointerStart = 0;

		const showSlide = (nextIndex: number, focusDot = false) => {
			activeIndex = (nextIndex + slides.length) % slides.length;
			slides.forEach((slide, index) => {
				slide.hidden = index !== activeIndex;
			});
			dots.forEach((dot, index) => {
				const selected = index === activeIndex;
				dot.setAttribute('aria-selected', String(selected));
				dot.tabIndex = selected ? 0 : -1;
			});
			if (focusDot) dots[activeIndex]?.focus();
		};

		dots.forEach((dot) => {
			dot.addEventListener('click', () => showSlide(Number(dot.dataset.index)));
			dot.addEventListener('keydown', (event) => {
				if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
				event.preventDefault();
				if (event.key === 'Home') showSlide(0, true);
				else if (event.key === 'End') showSlide(slides.length - 1, true);
				else showSlide(activeIndex + (event.key === 'ArrowRight' ? 1 : -1), true);
			});
		});

		carousel.addEventListener('pointerdown', (event) => {
			pointerStart = event.clientX;
		});
		carousel.addEventListener('pointerup', (event) => {
			const distance = event.clientX - pointerStart;
			if (Math.abs(distance) >= 48) showSlide(activeIndex + (distance < 0 ? 1 : -1));
		});
	});
</script>
