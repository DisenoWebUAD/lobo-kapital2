---
import travelIcon from "../assets/personal-credit/beneficio-viajes.svg";
import allianceIcon from "../assets/personal-credit/beneficio-alianzas.svg";
---

<section
	class="personal-rewards"
	id="beneficios"
	aria-labelledby="personal-rewards-title"
>
	<div class="personal-rewards__inner">
		<h2 id="personal-rewards-title" data-page-reveal>Recompensas que Suman Valor</h2>
		<p data-page-reveal>
			Nuestro programa de Cash Back está diseñado para devolver liquidez
			directamente a tu<br class="personal-cards__desktop-break" /> cuenta.
			Sin puntos complejos, solo dinero real.
		</p>

		<ul class="personal-rewards__list" data-page-reveal-group>
			<li data-page-reveal>
				<div class="personal-rewards__icon">
					<img src={travelIcon.src} alt="" width="38" height="37" />
				</div>
				<div>
					<h3>Beneficios de Viaje</h3>
					<p>
						Seguros de renta de auto, pérdida de equipaje y demoras
						de<br class="personal-cards__desktop-break" /> vuelo incluidos
						en tarjetas seleccionadas.
					</p>
				</div>
			</li>
			<li data-page-reveal>
				<div class="personal-rewards__icon">
					<img src={allianceIcon.src} alt="" width="38" height="37" />
				</div>
				<div>
					<h3>Alianzas Comerciales</h3>
					<p>
						Meses sin intereses y descuentos exclusivos tiendas<br
							class="personal-cards__desktop-break"
						/> departamentales.
					</p>
				</div>
			</li>
		</ul>
	</div>
</section>
