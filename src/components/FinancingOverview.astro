---
import { financingProducts } from '../data/financing-products';
import FinancingProcessGraphic from './FinancingProcessGraphic.astro';

interface Props { product: 'revolving' | 'finance-lease' }
const { product: productId } = Astro.props;
const product = financingProducts[productId];
---

<section class="financing-overview" aria-labelledby="financing-overview-title">
	<div class="financing-container">
		<header class="financing-overview__heading" data-page-reveal>
			<h2 id="financing-overview-title">Así funciona</h2>
		</header>
		<ol class="financing-overview__flow" role="list" data-page-reveal-group>
			{product.process.map((step, index) => (
				<li class="financing-overview__stage" data-page-reveal>
					<div class="financing-overview__graphic">
						<FinancingProcessGraphic product={productId} stage={index} />
					</div>
					<div class="financing-overview__step-copy">
						<h3>{step.title}</h3>
						<p>{step.description}</p>
					</div>
					{index < product.process.length - 1 && (
						<>
							<svg class="financing-overview__connector financing-overview__connector--horizontal" viewBox="0 0 100 20" preserveAspectRatio="none" fill="none" aria-hidden="true" focusable="false">
								<path d="M0 10h96m-8-6 8 6-8 6" />
							</svg>
							<svg class="financing-overview__connector financing-overview__connector--vertical" viewBox="0 0 20 100" preserveAspectRatio="none" fill="none" aria-hidden="true" focusable="false">
								<path d="M10 0v96m-6-8 6 8 6-8" />
							</svg>
						</>
					)}
				</li>
			))}
		</ol>
	</div>
</section>
