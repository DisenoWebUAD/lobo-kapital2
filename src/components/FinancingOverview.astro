---
import { financingProducts } from '../data/financing-products';

interface Props { product: 'revolving' | 'finance-lease' }
const { product: productId } = Astro.props;
const product = financingProducts[productId];
---

<section class="financing-overview" aria-labelledby="financing-overview-title">
	<div class="financing-container">
		<div class="financing-overview__intro" data-page-reveal-group>
			<header data-page-reveal>
				<h2 id="financing-overview-title">{productId === 'revolving' ? <>Un respaldo para tu <span>capital de trabajo.</span></> : <>Activos que acompañan tu <span>crecimiento.</span></>}</h2>
				<p>{product.intro}</p>
			</header>
			<div class="financing-overview__uses" data-page-reveal="fade">
				<h3>{productId === 'revolving' ? '¿En qué puedes utilizarlo?' : '¿Qué puedes financiar?'}</h3>
				<ul>{product.uses.map((use) => <li><span aria-hidden="true">↗</span>{use}</li>)}</ul>
			</div>
		</div>
		<header class="financing-process-heading" data-page-reveal><h2>Así <span>funciona</span></h2></header>
		<ol class="financing-process" data-page-reveal-group>
			{product.process.map((step) => <li data-page-reveal><h3>{step.title}</h3><p>{step.description}</p></li>)}
		</ol>
	</div>
</section>
