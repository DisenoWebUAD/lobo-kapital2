---
import { Picture } from 'astro:assets';
import { financingProducts } from '../data/financing-products';
import capitalImage from '../assets/editorial/capital.jpg';
import equipmentImage from '../assets/editorial/equipo.jpg';

interface Props { product: 'revolving' | 'finance-lease' }
const { product: productId } = Astro.props;
const product = financingProducts[productId];
const revolving = productId === 'revolving';
---

<section class="financing-hero" id="inicio" aria-labelledby="financing-hero-title">
	<div class="financing-hero__inner">
		<div class="financing-hero__copy">
			<h1 id="financing-hero-title">{revolving ? <>Crédito en<br />cuenta <span>corriente</span></> : <>Arrendamiento<br /><span>financiero</span></>}</h1>
			<p class="financing-hero__lead">{product.heroLead} {product.heroAccent}</p>
			<p class="financing-hero__description">{product.heroDescription}</p>
			<div class="financing-hero__actions">
				<a class="button button--primary" href="#simulador">{revolving ? 'Simula una disposición' : 'Simula tu arrendamiento'}</a>
				<a class="button button--outline" href="#solicitud">Pedir información</a>
			</div>
			<a class="financing-text-link" href="#requisitos">Conoce los requisitos <span aria-hidden="true">↓</span></a>
		</div>
		<div class="financing-hero__visual">
			<Picture
				src={revolving ? capitalImage : equipmentImage}
				formats={['webp']}
				fallbackFormat="jpeg"
				widths={[480, 768, 1024]}
				sizes="(max-width: 56.25em) calc(100vw - 2.5rem), (max-width: 90em) 45vw, 37.5rem"
				alt={revolving ? 'Dos personas preparando y entregando pedidos en una panadería' : 'Personal trabajando con equipo productivo en una empresa'}
				loading="eager"
				fetchpriority="high"
			/>
			<p>Imagen ilustrativa de uso empresarial</p>
		</div>
	</div>
</section>
