---
const steps = [
	{ title: 'Cuéntanos tu objetivo', description: 'Define qué necesita tu negocio. Te orientamos entre las alternativas de financiamiento.' },
	{ title: 'Evaluamos tu perfil', description: 'Revisamos tu actividad, capacidad de pago y la documentación que requiere el producto.' },
	{ title: 'Revisa tu propuesta', description: 'Conoce montos, plazos, pagos, garantías y costos antes de tomar una decisión.' },
	{ title: 'Formaliza y avanza', description: 'Si la operación se autoriza y decides continuar, se firma el contrato y se coordinan los siguientes pasos.' },
];
---

<section class="financing-process" id="proceso" aria-labelledby="process-title">
	<header class="financing-process__heading" data-reveal>
		<h2 id="process-title">Cómo <span>funciona</span></h2>
		<p>Un proceso acompañado, desde lo que necesitas hasta las condiciones de tu financiamiento.</p>
	</header>
	<ol class="financing-process__steps" data-reveal-group="70">
		{steps.map((step, index) => (
			<li data-reveal>
				<span class="financing-process__number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
				<div>
					<h3>{step.title}</h3>
					<p>{step.description}</p>
				</div>
			</li>
		))}
	</ol>
</section>

<style>
	.financing-process { width: min(calc(100% - 6rem), 79.75rem); margin: 6rem auto; scroll-margin-top: 7rem; }
	.financing-process__heading { display: grid; grid-template-columns: 1fr 1fr; align-items: end; gap: 3rem; margin-bottom: 3rem; }
	h2 { color: var(--color-ink); font-size: clamp(2.25rem, 3.8vw, 3.5rem); font-weight: 650; line-height: 1.08; letter-spacing: -.04em; }
	h2 span { color: var(--color-primary); }
	.financing-process__heading p { max-width: 46ch; font-size: 1.125rem; line-height: 1.6; }
	.financing-process__steps { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 2rem; padding: 0; list-style: none; }
	.financing-process__steps li { min-width: 0; }
	.financing-process__number { display: block; margin-bottom: 1.5rem; color: var(--color-primary); font-size: 3.5rem; font-weight: 450; line-height: 1; letter-spacing: -.055em; font-variant-numeric: tabular-nums; }
	h3 { color: var(--color-ink); font-size: 1.25rem; font-weight: 650; line-height: 1.3; letter-spacing: -.02em; }
	.financing-process__steps p { margin-top: .75rem; color: var(--color-muted); font-size: 1rem; line-height: 1.6; }
	@media (max-width: 63.9375em) {
		.financing-process { width: calc(100% - 4rem); margin-block: 4.5rem; }
		.financing-process__heading { align-items: start; gap: 2rem; }
		.financing-process__steps { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2.5rem 2rem; }
		.financing-process__steps li { display: grid; grid-template-columns: 3.5rem minmax(0, 1fr); gap: 1rem; }
		.financing-process__number { margin: 0; font-size: 2.75rem; }
	}
	@media (max-width: 47.9375em) {
		.financing-process { width: calc(100% - 2.5rem); margin-block: 3.5rem; }
		.financing-process__heading { grid-template-columns: 1fr; gap: 1.25rem; margin-bottom: 2rem; }
		.financing-process__heading p { font-size: 1.0625rem; }
		.financing-process__steps { grid-template-columns: 1fr; gap: 1.75rem; }
		.financing-process__steps li { grid-template-columns: 3rem minmax(0, 1fr); gap: .75rem; }
		.financing-process__number { font-size: 2.5rem; }
	}
</style>
