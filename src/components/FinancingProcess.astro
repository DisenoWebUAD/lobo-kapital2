---
const steps = [
	{
		title: 'Cuéntanos tu objetivo',
		description: 'Cuéntanos qué necesitas financiar. Te orientamos entre las alternativas disponibles.',
		iconPaths: ['M5 4h14a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H9l-6 4V6a2 2 0 0 1 2-2Z', 'M7 8h10M7 12h6'],
	},
	{
		title: 'Evaluamos tu perfil',
		description: 'Revisamos tu actividad, capacidad de pago y la documentación que requiere el producto.',
		iconPaths: ['M17 10a7 7 0 1 1-14 0a7 7 0 0 1 14 0Z', 'm15 15 6 6'],
	},
	{
		title: 'Revisa tu propuesta',
		description: 'Conoce montos, plazos, pagos, garantías y costos antes de decidir.',
		iconPaths: ['M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9l-6-6Z', 'M14 3v6h6M8 13h8M8 17h5'],
	},
	{
		title: 'Formaliza y avanza',
		description: 'Si la operación se autoriza y decides continuar, te orientamos en la firma del contrato y los siguientes pasos.',
		iconPaths: ['m13.5 6.5 4 4M4 20l4.5-1 12-12a2.8 2.8 0 0 0-4-4l-12 12L4 20Z', 'M13 21h7'],
	},
];
---

<section class="financing-process" id="proceso" aria-labelledby="process-title">
	<header class="financing-process__heading" data-reveal>
		<h2 id="process-title">Te acompañamos <span>en cada paso</span></h2>
	</header>
	<lobo-financing-process>
		<ol class="financing-process__steps" role="list">
			{steps.map((step, index) => (
				<li class="financing-process__step">
					{index < steps.length - 1 && (
						<span class="financing-process__connector" aria-hidden="true">
							<span class="financing-process__fill" data-process-fill></span>
						</span>
					)}
					<span class="financing-process__marker" data-process-marker style={`--process-index: ${index}`} aria-hidden="true">
						<svg class="financing-process__icon" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
							{step.iconPaths.map(path => <path d={path} />)}
						</svg>
					</span>
					<div class="financing-process__card">
						<h3>{step.title}</h3>
						<p>{step.description}</p>
					</div>
				</li>
			))}
		</ol>
	</lobo-financing-process>
</section>

<script>
	import { registerFinancingProcess } from '../lib/financing-process-client';
	registerFinancingProcess();
</script>

<style>
	.financing-process {
		width: min(calc(100% - 6rem), 79.75rem);
		margin: 2.5rem auto 6rem;
		scroll-margin-top: 7rem;
	}
	.financing-process__heading { margin-bottom: 2.5rem; }
	h2 {
		color: var(--color-ink);
		font-size: clamp(2.25rem, 3.8vw, 3.5rem);
		font-weight: 650;
		line-height: 1.08;
		letter-spacing: -.04em;
		text-wrap: balance;
	}
	h2 span { color: var(--color-primary); }
	lobo-financing-process {
		--process-marker-size: 2.5rem;
		--process-step-gap: 2.5rem;
		--process-axis: calc(var(--process-marker-size) / 2);
		display: block;
	}
	.financing-process__steps {
		display: grid;
		gap: var(--process-step-gap);
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.financing-process__step {
		position: relative;
		display: grid;
		grid-template-columns: var(--process-marker-size) minmax(0, 1fr);
		column-gap: 1rem;
		align-items: start;
		min-width: 0;
	}
	.financing-process__connector {
		position: absolute;
		top: calc(var(--process-marker-size) / 2);
		left: var(--process-axis);
		width: 2px;
		height: calc(100% + var(--process-step-gap));
		background: var(--color-soft);
		transform: translateX(-50%);
		pointer-events: none;
	}
	.financing-process__fill {
		display: block;
		width: 100%;
		height: 100%;
		background: var(--color-dark);
		transform: scaleY(var(--segment-progress, 0));
		transform-origin: top;
	}
	.financing-process__marker {
		position: relative;
		z-index: 1;
		grid-column: 1;
		grid-row: 1;
		display: grid;
		place-items: center;
		width: var(--process-marker-size);
		height: var(--process-marker-size);
		border-radius: 50%;
		color: var(--color-text);
		background: var(--color-soft);
		transition: color 180ms ease, background-color 180ms ease;
	}
	.financing-process__marker[data-reached] {
		color: var(--color-white);
		background: var(--color-dark);
	}
	.financing-process__card {
		grid-column: 2;
		grid-row: 1;
		min-width: 0;
		padding-block: .4375rem;
	}
	.financing-process__icon {
		display: block;
		width: 1.5rem;
		height: 1.5rem;
	}
	h3 {
		color: var(--color-ink);
		font-size: 1.25rem;
		font-weight: 650;
		line-height: 1.3;
		letter-spacing: -.02em;
	}
	.financing-process__card p {
		margin-top: .75rem;
		color: var(--color-muted);
		font-size: 1rem;
		line-height: 1.6;
	}
	@media (min-width: 64em) {
		lobo-financing-process { --process-step-gap: 2rem; }
		.financing-process__steps {
			grid-template-columns: repeat(4, minmax(0, 1fr));
			row-gap: .75rem;
		}
		.financing-process__step {
			column-gap: .75rem;
			grid-template-rows: subgrid;
			grid-row: span 2;
		}
		.financing-process__connector { display: none; }
		.financing-process__marker,
		.financing-process__marker[data-reached] {
			align-self: center;
			color: var(--color-text);
			background: var(--color-soft);
			transition: none;
		}
		.financing-process__card { display: contents; }
		.financing-process__card h3 {
			grid-column: 2;
			grid-row: 1;
			align-self: center;
		}
		.financing-process__card p {
			grid-column: 1 / -1;
			grid-row: 2;
			margin-top: 0;
		}
	}
	@media (min-width: 64em) {
		lobo-financing-process[data-desktop-sequence='playing'] .financing-process__marker {
			color: var(--color-white);
			background: var(--color-dark);
			transition: color 550ms ease-in-out, background-color 550ms ease-in-out;
			transition-delay: calc(200ms + var(--process-index) * 800ms);
		}
		lobo-financing-process[data-desktop-sequence='complete'] .financing-process__marker {
			color: var(--color-white);
			background: var(--color-dark);
		}
	}
	@media (max-width: 63.9375em) {
		.financing-process { width: calc(100% - 4rem); margin-block: 2.5rem 4.5rem; }
	}
	@media (max-width: 47.9375em) {
		.financing-process { width: calc(100% - 2.5rem); margin-block: 2rem 3.5rem; }
		.financing-process__heading { margin-bottom: 2rem; }
		lobo-financing-process {
			--process-step-gap: 1.75rem;
		}
	}
</style>
