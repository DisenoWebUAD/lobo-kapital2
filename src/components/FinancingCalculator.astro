---
import { formatCurrencyInput } from "../lib/currency-input";
import { contactEmail } from "../data/contact";
import { financingProducts } from "../data/financing-products";
import {
	revolvingDefaults,
	getLeaseDefaults,
	factoringDefaults,
	financingAssumptions,
} from "../lib/financing-simulation";
import "../styles/financing-calculator.css";

interface Props {
	product: "revolving" | "finance-lease" | "lease" | "factoring";
}
interface Field {
	name: string;
	label: string;
	type: "money" | "number" | "segmented" | "date";
	value: number | string;
	hint?: string;
	min?: number;
	max?: number;
	range?: boolean;
	step?: number;
	unit?: string;
	options?: { value: string; label: string }[];
}
const { product } = Astro.props;
const prefix = `financing-${product}`;
const isLease = product === "lease" || product === "finance-lease";
const initialLease = getLeaseDefaults(product === "lease" ? "pure" : "finance");
const percent = (value: number) =>
	new Intl.NumberFormat("es-MX", {
		style: "percent",
		maximumFractionDigits: 2,
	}).format(value);
const durationUnit = (value: number, field: string) =>
	field === "days"
		? value === 1
			? "día"
			: "días"
		: value === 1
			? "mes"
			: "meses";
const duration = (value: number, field: string) =>
	`${value} ${durationUnit(value, field)}`;
const fieldDescription = (field: Field) =>
	[
		`${prefix}-${field.name}-hint`,
		`${prefix}-${field.name}-error`,
		...(product === "finance-lease" && field.name === "termMonths"
			? [`${prefix}-term-adjustment`]
			: []),
	].join(" ");
const vat = percent(financingAssumptions.vatRate);
const revolving = financingAssumptions.revolving;
const lease = financingAssumptions.lease;
const factoring = financingAssumptions.factoring;
const headings = {
	revolving: ["Simula tu", "disposición"],
	"finance-lease": ["Simula tu", "arrendamiento"],
	lease: ["Simula tu", "arrendamiento"],
	factoring: ["Estima tu", "liquidez"],
};
const introductions = {
	revolving:
		"Indica el monto, los días y la fecha de disposición para estimar el primer pago mensual y el pago final.",
	"finance-lease":
		"Elige el activo, su valor y el plazo para estimar tu renta y la compra opcional al terminar.",
	lease: "Elige el activo, su valor y el plazo para estimar tu renta mensual.",
	factoring:
		"Indica el valor de tus facturas y los días para cobrarlas. Compara la liquidez estimada de ambas modalidades.",
};
const fields: Field[] =
	product === "revolving"
		? [
				{
					name: "amount",
					label: "¿Cuánto necesitas?",
					type: "money",
					value: revolvingDefaults.amount,
					min: 1,
				},
				{
					name: "days",
					label: "¿Por cuántos días?",
					type: "number",
					value: revolvingDefaults.days,
					min: 60,
					max: 360,
					range: true,
				},
				{
					name: "startDate",
					label: "Fecha estimada de disposición",
					type: "date",
					value: revolvingDefaults.startDate,
					hint: "La fecha cambia los días de cada periodo y los pagos estimados.",
				},
			]
		: isLease
			? [
					{
						name: "asset",
						label: "Tipo de activo",
						type: "segmented",
						value: initialLease.asset,
						options: [
							{ value: "vehicle", label: "Vehículo" },
							{
								value: "machinery",
								label: "Maquinaria o equipo",
							},
						],
					},
					{
						name: "assetValue",
						label: "Valor del activo sin IVA",
						type: "money",
						value: initialLease.value,
						min: 1,
					},
					{
						name: "termMonths",
						label: "Plazo en meses",
						type: "number",
						value: initialLease.months,
						min: product === "lease" ? 18 : 1,
						max: product === "lease" ? 36 : 120,
						range: true,
						hint:
							product === "finance-lease"
								? "* El plazo de contratación depende del activo y la evaluación."
								: undefined,
					},
				]
			: [
					{
						name: "invoiceAmount",
						label: "Valor de tus facturas",
						type: "money",
						value: factoringDefaults.amount,
						min: 1,
					},
					{
						name: "days",
						label: "Días que faltan para cobrarlas",
						type: "number",
						value: factoringDefaults.days,
						min: 1,
						max: factoring.maxDays,
					},
				];
const adjustments: Field[] =
	product === "revolving"
		? [
				{
					name: "line",
					label: "Línea de referencia para simular",
					type: "money",
					value: revolvingDefaults.amount,
					min: 1,
					hint: "Al inicio sigue el monto a disponer. Puedes cambiarla si ya tienes una referencia de tu línea.",
				},
				{
					name: "lineMonths",
					label: "Vigencia de la línea",
					type: "segmented",
					value: revolvingDefaults.lineMonths,
					options: revolving.lineMonths.map((value) => ({
						value: String(value),
						label: `${value} meses`,
					})),
				},
				{
					name: "annualInsurance",
					label: "Seguro anual",
					type: "money",
					value: revolvingDefaults.annualInsurance,
					min: 0,
				},
			]
		: isLease
			? [
					{
						name: "residualPercent",
						label: "Valor residual del activo",
						type: "number",
						value: initialLease.residualPercent,
						min: 0,
						max: 100,
						step: 0.01,
						unit: "%",
						hint:
							product === "lease"
								? "Es un supuesto para calcular la renta; no implica una compra al terminar."
								: "Define la compra opcional al terminar; no puede superar el principal después del anticipo.",
					},
					{
						name: "insurance",
						label: "Seguro mensual antes de IVA",
						type: "money",
						value: initialLease.insurance,
						min: 0,
					},
					{
						name: "services",
						label: "Servicios mensuales antes de IVA",
						type: "money",
						value: initialLease.services,
						min: 0,
					},
				]
			: [
					{
						name: "line",
						label: "Línea de referencia para simular",
						type: "money",
						value: factoringDefaults.amount,
						min: 0,
						hint: "Al inicio sigue el valor de las facturas. Sólo se utiliza para calcular la apertura cuando la incluyes.",
					},
					{
						name: "advancePercent",
						label: "Porcentaje de anticipo",
						type: "number",
						value: factoringDefaults.advancePercent,
						min: 0.01,
						max: 100,
						step: 0.01,
						unit: "%",
					},
					{
						name: "administrationCount",
						label: "Número de cargos de administración",
						type: "number",
						value: factoringDefaults.administrationCount,
						min: 0,
						max: factoring.maxAdministrationCount,
						step: 1,
						unit: "cargos",
					},
					{
						name: "expenses",
						label: "Gastos externos antes de IVA",
						type: "money",
						value: factoringDefaults.expenses,
						min: 0,
					},
				];
const assumptions =
	product === "revolving"
		? [
				`Tasa anual ilustrativa del ${percent(revolving.annualRate)}. Interés simple sobre días reales: monto × tasa × días / 360, más IVA del ${vat}.`,
				`Se modela una sola disposición al inicio. Apertura del ${percent(revolving.openingFeeRate)} de la línea capturada y disposición del ${percent(revolving.drawFeeRate)} del monto dispuesto, más IVA, por separado al inicio. La línea es una referencia editable, no un límite autorizado.`,
				"El primer pago mensual depende de la fecha capturada; no es una mensualidad fija. El capital completo se devuelve al vencimiento, junto con los intereses correspondientes. El seguro anual capturado se distribuye entre doce meses y continúa durante toda la vigencia de la línea, incluso después de devolver el capital. No se muestra un calendario contractual.",
			]
		: isLease
			? [
					`Tasa anual ilustrativa del ${percent(lease.annualRate)}; renta calculada como anualidad con el residual capturado. Apertura del ${percent(lease.openingFeeRate)} del valor del activo sin IVA, más IVA, por separado al inicio.`,
					product === "finance-lease"
						? `Residual inicial editable: ${percent(getLeaseDefaults("finance", "vehicle").residualPercent / 100)} en vehículo y ${percent(getLeaseDefaults("finance", "machinery").residualPercent / 100)} en maquinaria. La compra opcional es ese residual más IVA. El anticipo reduce el principal; no se estima otro tratamiento fiscal del anticipo.`
						: "El residual es un supuesto editable del cálculo de rentas. No se incluye un anticipo ni una compra al terminar. El depósito contractual está pendiente y queda excluido.",
					product === "finance-lease"
						? `Vehículo: IVA del ${vat} sobre renta, seguro y servicios. Maquinaria: IVA sobre renta; seguro y servicios se capturan como importes finales. Administración de ${formatCurrencyInput(lease.annualAdministration)} más IVA al inicio y en cada aniversario anterior al vencimiento. Límites del modelo: vehículo 1–120 meses; maquinaria 1–60 meses. No representan plazos autorizados.`
						: `IVA del ${vat} sobre renta, seguro y servicios capturados. Plazos del modelo: 18 a 36 meses. El tipo de activo identifica el escenario y no cambia la fórmula ni los cargos.`,
				]
			: [
					`Se compara una misma operación con tasa anual del ${percent(factoring.annualRate["with-recourse"])} con recurso y del ${percent(factoring.annualRate["without-recourse"])} sin recurso; descuento sobre el anticipo capturado, base de 360 días.`,
					`Apertura opcional del ${percent(factoring.openingFeeRate)} sobre la línea de referencia; operación del ${percent(factoring.operationFeeRate)} sobre las facturas; administración de ${formatCurrencyInput(factoring.administration)} por cargo. IVA del ${vat} sobre descuento, comisiones y gastos. La línea sigue inicialmente las facturas y puede editarse en los ajustes; no es un límite autorizado.`,
					"El porcentaje de anticipo, los cargos de administración y los gastos son supuestos editables. La reserva no anticipada está sujeta al cobro de las facturas y al contrato. La modalidad disponible y las obligaciones del cedente dependen de la evaluación y de la propuesta.",
				];
const exclusions =
	product === "factoring"
		? "Sólo se incluyen los gastos externos capturados. La reserva depende del cobro y del contrato."
		: product === "lease"
			? "Seguro y servicios sólo se incluyen por los importes capturados; el depósito contractual queda excluido."
			: product === "finance-lease"
				? "Seguro y servicios sólo se incluyen por los importes capturados; sus costos definitivos están pendientes de cotizar."
				: "El seguro sólo se incluye por el importe capturado; su aplicación y costo definitivos están pendientes de confirmar.";
---

<section
	id="simulador"
	class="financing-calculator"
	aria-labelledby={`${prefix}-title`}
>
	<lobo-financing-calculator
		class="financing-calculator__panel"
		data-product={product}
		data-ui
	>
		<div class="financing-calculator__grid">
			<div class="financing-calculator__controls">
				<header class="financing-calculator__heading">
					<h2 id={`${prefix}-title`}>
						{headings[product][0]}{" "}
						<span>{headings[product][1]}</span>
					</h2>
					<p>{introductions[product]}</p>
				</header>
				<form novalidate aria-labelledby={`${prefix}-title`}>
					<fieldset disabled data-controls>
						<legend class="visually-hidden"
							>Datos de la estimación</legend
						>
						<div class="financing-calculator__fields">
							{
								fields.map((field) => (
									<div
										class:list={[
											"financing-calculator__field",
											{
												"financing-calculator__field--manual":
													field.type !==
														"segmented" &&
													!field.range,
												"financing-calculator__field--secondary":
													(field.type === "number" &&
														!field.range) ||
													field.type === "date",
											},
										]}
									>
										{field.type === "segmented" ? (
											<fieldset class="financing-calculator__choice">
												<legend>{field.label}</legend>
												<div class="financing-calculator__segments">
													{field.options?.map(
														(option) => (
															<label>
																<input
																	type="radio"
																	class="visually-hidden"
																	name={
																		field.name
																	}
																	value={
																		option.value
																	}
																	checked={
																		option.value ===
																		String(
																			field.value,
																		)
																	}
																	required
																	aria-describedby={`${prefix}-${field.name}-error`}
																/>
																<span>
																	{
																		option.label
																	}
																</span>
															</label>
														),
													)}
												</div>
											</fieldset>
										) : (
											<>
												<div class="financing-calculator__field-heading">
													<label
														id={`${prefix}-${field.name}-label`}
														for={`${prefix}-${field.name}`}
													>
														{field.label}
													</label>
													<div
														class:list={[
															"financing-calculator__input",
															field.type ===
															"money"
																? "financing-calculator__input--money"
																: field.type ===
																	  "date"
																	? "financing-calculator__input--date"
																	: "financing-calculator__input--duration",
															{
																"financing-calculator__input--manual":
																	!field.range,
															},
														]}
													>
														<input
															id={`${prefix}-${field.name}`}
															name={field.name}
															type={
																field.type ===
																"date"
																	? "date"
																	: field.type ===
																		  "number"
																		? "number"
																		: "text"
															}
															value={
																field.type ===
																"money"
																	? formatCurrencyInput(
																			Number(
																				field.value,
																			),
																		)
																	: String(
																			field.value,
																		)
															}
															min={
																field.type ===
																"date"
																	? "0001-01-01"
																	: field.min
															}
															max={
																field.type ===
																"date"
																	? "9996-12-31"
																	: field.type ===
																		  "money"
																		? financingAssumptions.maxAmount
																		: field.max
															}
															step="1"
															data-money={
																field.type ===
																	"money" ||
																undefined
															}
															inputmode={
																field.type ===
																"money"
																	? "numeric"
																	: undefined
															}
															autocomplete="off"
															required
															aria-describedby={fieldDescription(field)}
														/>
														{field.type !==
															"date" && (
															<span
																aria-hidden="true"
																data-value-unit={
																	field.type ===
																	"number"
																		? field.name
																		: undefined
																}
															>
																{field.type ===
																"money"
																	? "MXN"
																	: durationUnit(
																			Number(
																				field.value,
																			),
																			field.name,
																		)}
															</span>
														)}
													</div>
												</div>
												{field.range && (
													<div class="financing-calculator__range-wrap">
														<input
															class="financing-calculator__range"
															type="range"
															min={field.min}
															max={field.max}
															step="1"
															value={Number(
																field.value,
															)}
															data-range-for={
																field.name
															}
															aria-labelledby={`${prefix}-${field.name}-label`}
															aria-describedby={fieldDescription(field)}
															aria-valuetext={duration(
																Number(
																	field.value,
																),
																field.name,
															)}
															style={`--range-progress: ${((Number(field.value) - Number(field.min)) / (Number(field.max) - Number(field.min))) * 100}%`}
														/>
														<div
															class="financing-calculator__bounds"
															aria-hidden="true"
														>
															<span>
																{duration(
																	Number(
																		field.min,
																	),
																	field.name,
																)}
															</span>
															<span
																data-range-bound={
																	field.name
																}
															>
																{duration(
																	Number(
																		field.max,
																	),
																	field.name,
																)}
															</span>
														</div>
													</div>
												)}
												<p
													id={`${prefix}-${field.name}-hint`}
													class="financing-calculator__hint"
												>
													{field.hint}
												</p>
												{product === "finance-lease" && field.name === "termMonths" && (
													<p
														id={`${prefix}-term-adjustment`}
														class="financing-calculator__hint"
														data-term-adjustment
														hidden
													/>
												)}
											</>
										)}
										<p
											id={`${prefix}-${field.name}-error`}
											class="financing-calculator__error"
											data-field-error={field.name}
											hidden
										/>
									</div>
								))
							}
							{
								product === "finance-lease" && (
									<div
										class="financing-calculator__field financing-calculator__field--manual financing-calculator__field--secondary"
										data-advance
									>
										<div class="financing-calculator__field-heading">
											<label for={`${prefix}-advance`}>
												Anticipo (opcional)
											</label>
											<div class="financing-calculator__input financing-calculator__input--money financing-calculator__input--manual">
												<input
													id={`${prefix}-advance`}
													name="advance"
													type="text"
													value={formatCurrencyInput(
														initialLease.advance,
													)}
													data-money
													inputmode="numeric"
													autocomplete="off"
													min="0"
													max={
														financingAssumptions.maxAmount
													}
													data-empty-zero
													aria-describedby={`${prefix}-advance-error`}
												/>
												<span aria-hidden="true">
													MXN
												</span>
											</div>
										</div>
										<p
											id={`${prefix}-advance-error`}
											class="financing-calculator__error"
											data-field-error="advance"
											hidden
										/>
									</div>
								)
							}
						</div>
						<details
							class="financing-calculator__adjustments"
							data-adjustments
						>
							<summary>Ajustar otros supuestos</summary>
							<p class="financing-calculator__hint">
								Personaliza estos datos si ya tienes una
								referencia. Un importe en cero excluye ese
								concepto del cálculo; no significa que sea
								gratuito.
							</p>
							<div class="financing-calculator__fields">
								{
									product === "factoring" && (
										<div class="financing-calculator__field">
											<label
												class="financing-calculator__checkbox"
												for={`${prefix}-includeOpening`}
											>
												<input
													id={`${prefix}-includeOpening`}
													name="includeOpening"
													type="checkbox"
													checked={
														factoringDefaults.includeOpening
													}
													aria-describedby={`${prefix}-includeOpening-error`}
												/>
												<span>
													Incluir comisión de apertura
													de la línea
												</span>
											</label>
											<p
												id={`${prefix}-includeOpening-error`}
												class="financing-calculator__error"
												data-field-error="includeOpening"
												hidden
											/>
										</div>
									)
								}
								{
									adjustments.map((field) => (
										<div class="financing-calculator__field financing-calculator__field--manual financing-calculator__field--secondary">
											{field.type === "segmented" ? (
												<fieldset class="financing-calculator__choice">
													<legend>
														{field.label}
													</legend>
													<div class="financing-calculator__segments financing-calculator__segments--terms">
														{field.options?.map(
															(option) => (
																<label>
																	<input
																		type="radio"
																		class="visually-hidden"
																		name={
																			field.name
																		}
																		value={
																			option.value
																		}
																		checked={
																			option.value ===
																			String(
																				field.value,
																			)
																		}
																		required
																		aria-describedby={`${prefix}-${field.name}-error`}
																	/>
																	<span>
																		{
																			option.label
																		}
																	</span>
																</label>
															),
														)}
													</div>
												</fieldset>
											) : (
												<div class="financing-calculator__field-heading">
													<label
														for={`${prefix}-${field.name}`}
														data-adjustment-label={
															field.name
														}
													>
														{field.label}
													</label>
													<div
														class:list={[
															"financing-calculator__input financing-calculator__input--manual",
															field.type ===
															"money"
																? "financing-calculator__input--money"
																: "financing-calculator__input--number",
														]}
													>
														<input
															id={`${prefix}-${field.name}`}
															name={field.name}
															type={
																field.type ===
																"money"
																	? "text"
																	: "number"
															}
															value={
																field.type ===
																"money"
																	? formatCurrencyInput(
																			Number(
																				field.value,
																			),
																		)
																	: String(
																			field.value,
																		)
															}
															min={field.min}
															max={
																field.type ===
																"money"
																	? financingAssumptions.maxAmount
																	: field.max
															}
															step={
																field.step ?? 1
															}
															data-money={
																field.type ===
																	"money" ||
																undefined
															}
															data-empty-zero={
																(field.type ===
																	"money" &&
																	field.min ===
																		0) ||
																undefined
															}
															inputmode={
																field.type ===
																"money"
																	? "numeric"
																	: field.step ===
																		  0.01
																		? "decimal"
																		: undefined
															}
															autocomplete="off"
															required={
																field.type ===
																	"number" ||
																field.min !== 0
															}
															aria-describedby={`${prefix}-${field.name}-hint ${prefix}-${field.name}-error`}
														/>
														<span aria-hidden="true">
															{field.type ===
															"money"
																? "MXN"
																: field.unit}
														</span>
													</div>
												</div>
											)}
											<p
												id={`${prefix}-${field.name}-hint`}
												class="financing-calculator__hint"
												data-line-note={
													field.name === "line" ||
													undefined
												}
											>
												{field.hint}
											</p>
											<p
												id={`${prefix}-${field.name}-error`}
												class="financing-calculator__error"
												data-field-error={field.name}
												hidden
											/>
										</div>
									))
								}
							</div>
						</details>
					</fieldset>
					<p
						class="financing-calculator__error"
						data-form-error
						role="alert"
						hidden
					>
					</p>
					<noscript
						><p class="financing-calculator__hint">
							Activa JavaScript para usar el simulador o <a
								href={`mailto:${contactEmail}`}
								>prepara un correo para solicitar orientación</a
							>. El correo no se envía automáticamente.
						</p></noscript
					>
				</form>
			</div>
			<div
				class="financing-calculator__result"
				aria-labelledby={`${prefix}-result-title`}
			>
				<div data-empty>
					<p class="financing-calculator__empty-title">
						Tu estimación aparecerá aquí.
					</p>
					<p>
						Completa los datos para consultar los importes estimados
						y su desglose.
					</p>
				</div>
				<div data-result hidden>
					<h3
						class="financing-calculator__result-label"
						id={`${prefix}-result-title`}
						data-result-label
					>
					</h3>
					{
						product === "factoring" ? (
							<>
								<p
									class="financing-calculator__context"
									data-context
								/>
								<div class="financing-calculator__comparison">
									{(
										[
											"without-recourse",
											"with-recourse",
										] as const
									).map((mode) => (
										<div
											class="financing-calculator__modality"
											data-modality={mode}
										>
											<h4>
												{mode === "without-recourse"
													? "Sin recurso"
													: "Con recurso"}
											</h4>
											<p class="financing-calculator__payment">
												<span data-payment />
												<small>MXN</small>
											</p>
											<p
												class="financing-calculator__context"
												data-deduction
											/>
										</div>
									))}
								</div>
							</>
						) : (
							<>
								<p class="financing-calculator__payment">
									<>
										<span data-payment />
										<small>MXN</small>
									</>
								</p>
								<p
									class="financing-calculator__context"
									data-context
								/>
							</>
						)
					}
					<dl class="financing-calculator__breakdown" data-breakdown>
					</dl>
					<details class="financing-calculator__costs" data-costs>
						<summary>Ver desglose de costos</summary>
						<div data-cost-breakdown></div>
					</details>
				</div>
			</div>
		</div>
		<footer class="financing-calculator__reference">
			<p
				class="financing-calculator__result-note"
				data-result-note
				hidden
			>
			</p>
			<p class="financing-calculator__exclusion">{exclusions}</p>
			<div>
				<p>
					El monto y las condiciones definitivas están sujetas a
					evaluación.
				</p>
				<details>
					<summary>Consultar supuestos del cálculo</summary>
					{assumptions.map((text) => <p>{text}</p>)}
					<p>{financingProducts[product].catDisclosure}</p>
				</details>
			</div>
		</footer>
		<p
			class="visually-hidden"
			role="status"
			aria-live="polite"
			aria-atomic="true"
			data-status
		>
		</p>
	</lobo-financing-calculator>
</section>

<script>
	import { registerFinancingCalculator } from "../lib/financing-calculator-client";
	registerFinancingCalculator();
</script>
