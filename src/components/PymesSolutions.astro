---
import { credits } from "../data/credits";

const { overview } = credits.business;
---

<section
	class="pymes-solutions"
	id="soluciones"
	aria-labelledby="pymes-solutions-title"
>
	<div class="pymes-solutions__inner">
		<div class="pymes-solutions__grid" data-page-reveal-group>
			<div data-page-reveal>
				<h2 id="pymes-solutions-title">
					¿Para qué puedes <span>utilizarlo?</span>
				</h2>
				<ul class="pymes-solutions__list">
					{
						overview.uses.map((use) => (
							<li>
								<>
									<span aria-hidden="true">↗</span>
									<span>{use}</span>
								</>
							</li>
						))
					}
				</ul>
			</div>
			<div data-page-reveal>
				<h2>Beneficios para <span>tu operación.</span></h2>
				<ul class="pymes-solutions__list">
					{
						overview.benefits.map((benefit) => (
							<li>
								<>
									<svg
										viewBox="0 0 24 24"
										width="18"
										height="18"
										fill="none"
										aria-hidden="true"
									>
										<path
											d="m5 12 4 4L19 6"
											stroke="currentColor"
											stroke-width="2"
											stroke-linecap="round"
											stroke-linejoin="round"
										/>
									</svg>
									<span>{benefit}</span>
								</>
							</li>
						))
					}
				</ul>
			</div>
		</div>
		<div class="pymes-solutions__context" data-page-reveal-group>
			<div data-page-reveal>
				<h3>¿Para quién?</h3>
				<p>{overview.audience}</p>
			</div>
			<div data-page-reveal>
				<h3>¿Cómo funciona?</h3>
				<p>{overview.operation}</p>
			</div>
		</div>
	</div>
</section>
