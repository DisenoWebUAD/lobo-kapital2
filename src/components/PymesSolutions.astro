---
import EditorialCard from './EditorialCard.astro';
import workCapitalImage from '../assets/editorial/capital.jpg';
import equipmentImage from '../assets/editorial/equipo.jpg';
import inventoryImage from '../assets/editorial/inventario.jpg';

const solutions = [
	{
		title: "Capital de trabajo",
		description:
			"Mantén la liquidez de tu operación diaria, cubre nóminas, proveedores o aprovecha oportunidades inmediatas en el mercado.",
		image: workCapitalImage,
		alt: 'Un equipo preparando pedidos en una panadería',
	},
	{
		title: "Equipo para tu negocio",
		description:
			"Moderniza tu maquinaria, tecnología o flotilla vehicular para aumentar tu capacidad productiva y competitividad.",
		image: equipmentImage,
		alt: 'Un operador trabajando con maquinaria en un taller',
	},
	{
		title: "Inventario",
		description:
			"Asegura el stock necesario para temporadas altas sin comprometer tu flujo de efectivo operativo.",
		image: inventoryImage,
		alt: 'Dos personas organizando el inventario de un negocio',
	},
];
---

<section
	class="pymes-solutions"
	id="soluciones"
	aria-labelledby="pymes-solutions-title"
>
	<header class="pymes-solutions__heading" data-page-reveal>
		<h2 id="pymes-solutions-title">Impulsa tu <span>Crecimiento</span></h2>
		<p>Soluciones financieras adaptadas a cada etapa de tu negocio.</p>
	</header>

	<div class="pymes-solutions__grid" data-page-reveal-group>
		{
			solutions.map((solution) => (
				<EditorialCard {...solution} />
			))
		}
	</div>
</section>
