---
import { Picture } from "astro:assets";
import heroImage from "../assets/pymes/hero.jpg";
import logoMark from "../assets/home/logo-mark.svg";
import RegulatoryLogos from "./RegulatoryLogos.astro";

// Include the rendered width of the cover crop, not just the image element.
const imageSizes =
	"(max-width: 47.9375em) max(100vw, min(67.5rem, 150svh)), 100vw";
---

<div class="hero-stage">
	<section class="hero" id="inicio" aria-labelledby="hero-title">
		<Picture
			src={heroImage}
			formats={["avif", "webp"]}
			widths={[768, 1280, 1920, 2400]}
			sizes={imageSizes}
			alt=""
			class="hero__media"
			pictureAttributes={{ class: "hero__picture" }}
			loading="eager"
			fetchpriority="high"
		/>
		<div class="hero__shade" aria-hidden="true"></div>
		<div class="hero__content" data-reveal-group="90">
			<img
				class="hero__mark"
				src={logoMark.src}
				alt="Lobo Kapital"
				width="130"
				height="134"
				data-reveal
			/>
			<h1 id="hero-title" data-reveal data-reveal-delay="80">
				Impulsa tu futuro con{" "}<br />financiamiento inteligente para
				ti y tu negocio.
			</h1>
			<p data-reveal>
				Créditos a tu medida con la transparencia que mereces.
				Soluciones financieras diseñadas<br class="desktop-only" /> para hacer
				crecer tu patrimonio y tu negocio.
			</p>
			<div class="hero__actions" data-reveal>
				<a class="button button--primary" href="#contacto"
					>Solicita tu crédito hoy</a
				>
				<a class="button button--light" href="#contacto"
					>Habla con un asesor</a
				>
			</div>
		</div>
	</section>
	<div
		class="hero-regulatory"
		role="group"
		aria-labelledby="hero-regulatory-label"
	>
		<p id="hero-regulatory-label">Regulada y supervisada por:</p>
		<RegulatoryLogos variant="band" />
	</div>
	<div class="brand-tab" aria-hidden="true">
		<svg
			class="brand-tab__shape"
			viewBox="0 0 806 220"
			preserveAspectRatio="none"
		>
			<path
				d="M0 0h806C689 71 541 160 458 206c-16 9-32 14-51 14h-8c-19 0-35-5-51-14C265 160 117 71 0 0Z"
			></path>
		</svg>
		<div class="brand-tab__logo"><span>LOBO</span><span>KAPITAL</span></div>
	</div>
</div>
