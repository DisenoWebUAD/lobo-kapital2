---
import { Picture } from "astro:assets";
import heroImage from "../assets/home/hero.jpg";
import RegulatoryLogos from "./RegulatoryLogos.astro";

// Include the rendered width of the cover crop, not just the image element.
const imageSizes = [
	"(max-width: 767px) max(100vw, min(1366px, 190svh))",
	"(min-width: 768px) and (max-width: 1199px) and (min-aspect-ratio: 4/3) max(calc(100vw + 280px), min(1518px, 190svh))",
	"(max-width: 1199px) max(100vw, min(1518px, 190svh))",
	"(min-width: 1200px) and (max-width: 1439px) and (min-aspect-ratio: 4/3) calc(1680px - 16.667vw)",
	"100vw",
].join(", ");
---

<div class="hero-stage">
	<section class="hero" id="inicio" aria-labelledby="hero-title">
		<Picture
			src={heroImage}
			formats={["avif", "webp"]}
			widths={[768, 1280, 1920, 2400]}
			sizes={imageSizes}
			alt=""
			class="hero__media"
			pictureAttributes={{ class: "hero__picture" }}
			loading="eager"
			fetchpriority="high"
		/>
		<div class="hero__shade" aria-hidden="true"></div>
		<div class="hero__content" data-reveal-group="90">
			<h1 id="hero-title" data-reveal data-reveal-delay="80">
				Impulsa tu futuro con{" "}<br />financiamiento inteligente.
			</h1>
			<p data-reveal>
				Créditos a tu medida con la transparencia que mereces. Soluciones
				financieras diseñadas<br class="desktop-only" /> para hacer crecer tu
				patrimonio y tu negocio.
			</p>
			<div class="hero__actions" data-reveal>
				<a class="button button--primary" href="#contacto"
					>Solicitar ahora <span aria-hidden="true">→</span></a
				>
				<a class="button button--light" href="#soluciones">Conocer más</a>
			</div>
		</div>
	</section>
	<div class="hero-regulatory" role="group" aria-labelledby="hero-regulatory-label">
		<p id="hero-regulatory-label">Regulada y supervisada por:</p>
		<RegulatoryLogos variant="band" />
	</div>
	<div class="brand-tab" aria-hidden="true">
		<svg
			class="brand-tab__shape"
			viewBox="0 0 806 220"
			preserveAspectRatio="none"
		>
			<path
				d="M0 0h806C689 71 541 160 458 206c-16 9-32 14-51 14h-8c-19 0-35-5-51-14C265 160 117 71 0 0Z"
			></path>
		</svg>
		<div class="brand-tab__logo"><span>LOBO</span><span>KAPITAL</span></div>
	</div>
</div>
