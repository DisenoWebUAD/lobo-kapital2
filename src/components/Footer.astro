---
import logoMark from "../assets/home/logo-mark.svg";
import RegulatoryLogos from "./RegulatoryLogos.astro";
import GroupLoboMark from "../assets/grupo-lobo-mark.svg";
import { legalEntity, legalLinks, transparencyLinks } from "../data/legal";
// Reused from santander-live, preserving the original paths and view boxes.
import FacebookIcon from "../assets/icons/social/facebook.svg";
import InstagramIcon from "../assets/icons/social/instagram.svg";
import XIcon from "../assets/icons/social/x.svg";
import TiktokIcon from "../assets/icons/social/tiktok.svg";
import WhatsappIcon from "../assets/icons/social/whatsapp.svg";

const socialIcons = [
	{ label: "Facebook", Icon: FacebookIcon },
	{ label: "Instagram", Icon: InstagramIcon },
	{ label: "X", Icon: XIcon },
	{ label: "TikTok", Icon: TiktokIcon },
	{ label: "WhatsApp", Icon: WhatsappIcon },
];

const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="site-footer__main">
		<div class="site-footer__contact">
			<a
				class="site-footer__mark"
				href="/"
				aria-label="Lobo Kapital, volver al inicio"
			>
				<img
					src={logoMark.src}
					alt="Lobo Kapital"
					width="100"
					height="103"
				/>
			</a>
			<a class="site-footer__phone" href="tel:+526181296093"
				>+52 618 129 6093</a
			>
			<a class="site-footer__email" href="mailto:contacto@lobokapital.mx"
				>contacto@lobokapital.mx</a
			>
			<address>{legalEntity.address}</address>
			<div class="site-footer__group" role="img" aria-label="Una empresa del Grupo Lobo">
				<GroupLoboMark width="44" height="44" aria-hidden="true" focusable="false" />
				<span aria-hidden="true">
					<span>Una empresa del</span>
					<strong>Grupo Lobo</strong>
				</span>
			</div>
			<RegulatoryLogos />
		</div>

		<div class="site-footer__social">
			<p>Síguenos</p>
			<div
				class="social-icons"
				aria-label="Redes sociales disponibles próximamente"
			>
				{
					socialIcons.map(({ label, Icon }) => (
						<span role="img" aria-label={label}>
							<Icon aria-hidden="true" focusable="false" />
						</span>
					))
				}
			</div>
		</div>
	</div>

	<section class="site-footer__transparency" aria-label="Atención y transparencia">
		<nav aria-label="Atención y transparencia">
			<ul>
				<li><a href={legalLinks.privacy} target="_self">Aviso de privacidad integral</a></li>
				<li><a href={legalLinks.conditions}>Condiciones generales</a></li>
				<li><a href={legalLinks.une}>UNE · Atención a usuarios</a></li>
				{transparencyLinks.map(({ label, href }) => (
					<li><a href={href} target="_blank" rel="noopener noreferrer">{label}<span aria-hidden="true"> ↗</span><span class="site-footer__sr-only"> (abre en otra pestaña)</span></a></li>
				))}
			</ul>
		</nav>
		<p class="site-footer__copyright">Copyright © {year} Grupo Lobo</p>
	</section>
</footer>

<style>
	.site-footer__group {
		display: inline-flex;
		align-items: center;
		gap: 12px;
		margin-top: 44px;
		color: var(--color-text);
	}

	.site-footer__group :global(svg) {
		flex-shrink: 0;
		width: 44px;
		height: 44px;
	}

	.site-footer__group > span {
		display: grid;
		gap: 4px;
		text-transform: uppercase;
		line-height: 1.2;
		letter-spacing: .1em;
	}

	.site-footer__group span span {
		font-size: 10px;
	}

	.site-footer__group strong {
		font-size: 13px;
		font-weight: 700;
	}

	.site-footer__transparency {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 24px 32px;
		margin-top: 56px;
		padding-top: 28px;
		border-top: 1px solid #dedede;
	}

	.site-footer__transparency nav {
		flex: 1;
		min-width: 0;
	}

	.site-footer__transparency ul {
		display: flex;
		flex-wrap: wrap;
		gap: 12px 28px;
		padding: 0;
		list-style: none;
		font-size: 14px;
		line-height: 1.6;
	}

	.site-footer__transparency a {
		display: inline-block;
		color: var(--color-muted);
		text-decoration: none;
		transition: color 150ms ease;
	}

	.site-footer__transparency a:hover {
		color: var(--color-text);
	}

	.site-footer__copyright {
		flex-shrink: 0;
		color: var(--color-muted);
		font-size: 14px;
		line-height: 1.6;
	}

	.site-footer__sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}

	@media (max-width: 767px) {
		.site-footer__transparency {
			flex-direction: column;
			align-items: flex-start;
			margin-top: 48px;
			padding-top: 24px;
		}

		.site-footer__transparency ul {
			flex-direction: column;
			align-items: flex-start;
		}

	}
</style>
