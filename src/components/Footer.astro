---
import logoMark from "../assets/home/logo-mark.svg";
import condusefLogo from "../assets/home/condusef-sipres.webp";
import cnbvLogo from "../assets/home/cnbv-logo.svg";
import institutionalLogo from "../assets/lobos-gestion-empresarial-logo.svg";
import { privacyUrl } from "../data/contact";
// Reused from santander-live, preserving the original paths and view boxes.
import FacebookIcon from "../assets/icons/social/facebook.svg";
import InstagramIcon from "../assets/icons/social/instagram.svg";
import XIcon from "../assets/icons/social/x.svg";
import TiktokIcon from "../assets/icons/social/tiktok.svg";
import WhatsappIcon from "../assets/icons/social/whatsapp.svg";

const socialIcons = [
	{ label: "Facebook", Icon: FacebookIcon },
	{ label: "Instagram", Icon: InstagramIcon },
	{ label: "X", Icon: XIcon },
	{ label: "TikTok", Icon: TiktokIcon },
	{ label: "WhatsApp", Icon: WhatsappIcon },
];

const year = new Date().getFullYear();
const isHomePage = Astro.url.pathname === "/";
---

<footer class="site-footer">
	<div class="site-footer__main">
		<div class="site-footer__contact">
			<a
				class="site-footer__mark"
				href="/"
				aria-label="Lobo Kapital, volver al inicio"
			>
				<img
					src={logoMark.src}
					alt="Lobo Kapital"
					width="130"
					height="134"
				/>
			</a>
			<a class="site-footer__phone" href="tel:+526181296093"
				>+52 618 129 6093</a
			>
			<a class="site-footer__email" href="mailto:contacto@lobokapital.mx"
				>contacto@lobokapital.mx</a
			>
			<address>
				Avenida Universidad Autónoma de Durango #300.<br />Colonia
				Jardines de Durango. Durango, Durango, México.
			</address>
			{
				isHomePage ? (
					<div
						class="regulatory-logos"
						aria-label="Instituciones regulatorias"
					>
						<img
							src={condusefLogo.src}
							alt="CONDUSEF SIPRES"
							width="82"
							height="82"
						/>
						<img
							src={cnbvLogo.src}
							alt="Comisión Nacional Bancaria y de Valores, CNBV"
							width="88"
							height="50"
						/>
					</div>
				) : (
					<img
						class="site-footer__institutional-logo"
						src={institutionalLogo.src}
						alt="Lobos Gestión Empresarial, S.A. de C.V., SOFOM, E.N.R."
						width="261"
						height="55"
					/>
				)
			}
		</div>

		<div class="site-footer__social">
			<nav class="site-footer__products" aria-label="Productos">
				<a href="/credito-personal/">Crédito personal</a>
				<a href="/creditos-pymes/">Crédito empresarial</a>
				<a href="/tarjetas/">Tarjetas</a>
			</nav>
			<p>Síguenos</p>
			<div
				class="social-icons"
				aria-label="Redes sociales disponibles próximamente"
			>
				{
					socialIcons.map(({ label, Icon }) => (
						<span role="img" aria-label={label}>
							<Icon aria-hidden="true" focusable="false" />
						</span>
					))
				}
			</div>
		</div>
	</div>

	<div class="site-footer__legal">
		<div>
			<a href={privacyUrl} target="_blank" rel="noopener noreferrer">Aviso de privacidad</a>
			<span aria-disabled="true">Términos y condiciones</span>
			<span>Lobos Gestión Empresarial, S.A. de C.V., SOFOM, E.N.R.</span>
		</div>
		<p>Copyright © {year}</p>
	</div>
</footer>

<style>
	.site-footer__legal a:hover {
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.site-footer__products {
		display: flex;
		flex-wrap: wrap;
		justify-content: flex-end;
		gap: 12px 24px;
		margin-bottom: 40px;
		font-size: 14px;
		font-weight: 600;
	}

	.site-footer__products a:hover {
		color: var(--color-primary);
	}

	@media (max-width: 767px) {
		.site-footer__products {
			justify-content: flex-start;
		}
	}
</style>
