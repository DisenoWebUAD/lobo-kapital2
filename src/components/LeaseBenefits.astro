---
import deductibilityIcon from "../assets/arrendamiento/deducibilidad-fiscal.svg";
import liquidityIcon from "../assets/arrendamiento/reloj.svg";
import billsIcon from "../assets/arrendamiento/billetes.svg";

const benefits = [
	{
		title: "Deducibilidad Fiscal al 100%",
		description:
			"Las rentas de arrendamiento puro se consideran un gasto operativo, con deducibilidad de hasta el 100% del pago mensual.",
		icon: deductibilityIcon,
	},
	{
		title: "Liquidez Mejorada",
		description:
			"Conserva tu capital de trabajo y dirige tus recursos a otras necesidades de tu operación.",
		icon: liquidityIcon,
	},
	{
		title: "Activos para tu operación",
		description:
			"Incorpora vehículos, maquinaria o tecnología para acompañar las necesidades de tu negocio.",
		icon: billsIcon,
	},
];
---

<section
	class="lease-benefits"
	id="beneficios"
	aria-labelledby="lease-benefits-title"
>
	<header class="lease-section-heading" data-page-reveal>
		<h2 id="lease-benefits-title"><span>Beneficios</span> Financieros</h2>
		<p>Estrategias inteligentes para el flujo de efectivo.</p>
	</header>

	<div class="lease-benefits__grid" data-page-reveal-group>
		{
			benefits.map((benefit) => (
				<article class="lease-benefit-card" data-page-reveal>
					<div class="lease-benefit-card__icon">
						<img
							src={benefit.icon.src}
							alt=""
							width="49"
							height="49"
						/>
					</div>
					<h3>{benefit.title}</h3>
					<p>{benefit.description}</p>
				</article>
			))
		}
	</div>
</section>
