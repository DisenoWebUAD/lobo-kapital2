---
import heroImage from "../assets/factoraje/hero.jpg";
---

<section
	class="factoring-hero"
	id="inicio"
	aria-labelledby="factoring-hero-title"
>
	<div class="factoring-hero__inner">
		<div class="factoring-hero__copy">
			<h1 id="factoring-hero-title">
				Convierte tus Cuentas <span class="factoring-hero__muted"
					>por</span
				><br /><span class="factoring-hero__muted">Cobrar en</span>
				<span class="factoring-hero__highlight"
					>Liquidez<br />Inmediata</span>
			</h1>
			<p>
				Optimiza tu flujo de caja sin generar deuda.<br />Adelantamos el
				pago de tus facturas para<br />que tu empresa nunca se detenga.
			</p>
			<div class="factoring-hero__actions">
				<a
					class="button button--primary"
					href="#contacto"
					>Inicia tu Factoraje Hoy</a
				>
				<a class="button button--light" href="tel:+526181296093"
					>Hablar con un Asesor</a
				>
			</div>
		</div>
		<img
			class="factoring-hero__image"
			src={heroImage.src}
			alt="Emprendedora revisando información de su negocio"
			width="1417"
			height="1290"
		/>
	</div>
</section>
