---
import { Picture } from "astro:assets";
import heroImage from "../assets/factoraje/hero.jpg";

const imageSizes =
	"(max-width: 40em) calc(100vw - 3rem), (max-width: 48.4375em) calc(100vw - 6rem), (max-width: 63.9375em) 42.5rem, (max-width: 119.9375em) 50.16vw, 60.1875rem";
---

<section
	class="factoring-hero"
	id="inicio"
	aria-labelledby="factoring-hero-title"
>
	<div class="factoring-hero__inner">
		<div class="factoring-hero__copy">
			<h1 id="factoring-hero-title">
				Convierte tus Cuentas{" "}
				<span class="factoring-hero__muted">por{" "}<br />Cobrar en</span>{" "}
				<span class="factoring-hero__highlight"
					>Liquidez{" "}<br />para tu Negocio</span>
			</h1>
			<p>
				Anticipa cuentas por cobrar elegibles y planea tu flujo de caja.
				La modalidad y el importe dependen del análisis de tus facturas,
				el pagador y la operación.
			</p>
			<div class="factoring-hero__actions">
				<a
					class="button button--primary"
					href="#simulador"
					>Simula tu Liquidez</a
				>
				<a class="button button--light" href="#contacto"
					>Pedir información</a
				>
			</div>
		</div>
		<div class="factoring-hero__visual">
			<Picture
				class="factoring-hero__image"
				src={heroImage}
				formats={["webp"]}
				fallbackFormat="jpeg"
				quality={85}
				widths={[480, 768, 1024, 1417]}
				sizes={imageSizes}
				pictureAttributes={{ style: "display: contents;" }}
				alt="Emprendedora revisando información de su negocio"
				width={1417}
				height={1290}
				loading="eager"
				fetchpriority="high"
			/>
		</div>
	</div>
</section>
