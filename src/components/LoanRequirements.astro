---
interface Props {
	product: 'personal' | 'business';
}
const { product } = Astro.props;
const business = product === 'business';
const requirements = business ? [
	'Empresa con al menos 24 meses de operación.',
	'Estados financieros y constancia de situación fiscal. Historial crediticio y capacidad de pago sujetos a evaluación.',
	'Garantía conforme al monto y al perfil de la operación.',
] : [
	'Identificación oficial INE y comprobante de ingresos.',
	'Puntaje de Buró de Crédito de al menos 600, sujeto a validación y análisis de capacidad de pago.',
];
const intro = business
	? 'Para empresas con operación formal y flujo comprobable. La evaluación considera ingresos, historial y capacidad de pago.'
	: 'Para personas asalariadas, profesionistas o con ingresos comprobables. La autorización depende de tu historial crediticio y capacidad de pago.';
---

<div class="loan-requirements" id="requisitos" data-page-reveal>
	<h2 id="credit-details-title">¿Puede ser <span>{business ? 'para tu empresa' : 'para ti'}</span>?</h2>
	<p class="loan-requirements__intro">
		{intro}
	</p>
	<ul>
		{
			requirements.map((requirement) => (
				<li>
					<svg
						viewBox="0 0 24 24"
						width="18"
						height="18"
						fill="none"
						aria-hidden="true"
					>
						<path
							d="m5 12 4 4L19 6"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
						/>
					</svg>
					<span>{requirement}</span>
				</li>
			))
		}
	</ul>
	<p class="loan-requirements__note">
		No necesitas adjuntar documentos al pedir información. Si inicias el
		trámite, un asesor te indicará el canal para enviarlos.
	</p>
</div>

<style>
	.loan-requirements {
		min-width: 0;
		padding-top: 2rem;
	}

	h2 {
		font-size: 2rem;
		line-height: 1.2;
		letter-spacing: -0.0375rem;
		color: #000;
	}

	h2 span {
		color: var(--color-primary);
	}

	.loan-requirements__intro {
		margin-top: 1.25rem;
		font-size: 1rem;
		line-height: 1.6;
		color: var(--color-text);
	}

	ul {
		display: grid;
		gap: 1rem;
		margin: 1.75rem 0 0;
		padding: 0;
		list-style: none;
	}

	li {
		display: flex;
		gap: 0.75rem;
		align-items: flex-start;
		font-size: 1rem;
		line-height: 1.6;
	}

	li svg {
		flex-shrink: 0;
		margin-top: 0.1875rem;
		color: var(--color-primary);
	}

	.loan-requirements__note {
		margin-top: 1.5rem;
		font-size: 0.875rem;
		line-height: 1.6;
		color: var(--color-muted);
	}

	@media (max-width: 56.25em) {
		.loan-requirements {
			padding-top: 0;
		}
	}

	@media (max-width: 47.9375em) {
		h2 {
			font-size: 1.75rem;
		}
	}
</style>
