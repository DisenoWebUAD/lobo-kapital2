---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	image: ImageMetadata;
	title: string;
	description: string;
	alt: string;
	as?: 'article' | 'li';
	variant?: 'surface' | 'white';
	sizes?: string;
}

const {
	image,
	title,
	description,
	alt,
	as: Tag = 'article',
	variant = 'surface',
	sizes = '(max-width: 47.9375em) calc(100vw - 2.5rem), (max-width: 85.75em) calc((100vw - 9rem) / 3), 25.625rem',
}: Props = Astro.props;
---

<Tag class:list={['editorial-card', `editorial-card--${variant}`]} data-page-reveal>
	<Image
		src={image}
		alt={alt}
		width={960}
		height={640}
		widths={[384, 640, 960]}
		sizes={sizes}
		format="webp"
		quality={85}
		loading="lazy"
		decoding="async"
	/>
	<div class="editorial-card__copy">
		<h3>{title}</h3>
		<p>{description}</p>
	</div>
</Tag>

<style>
	.editorial-card {
		min-width: 0;
		overflow: hidden;
		border-radius: 1.125rem;
		background: var(--color-surface);
	}
	.editorial-card--white {
		background: var(--color-white);
	}
	img {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 16 / 10;
		object-fit: cover;
	}
	.editorial-card__copy {
		padding: 1.625rem 1.75rem 1.875rem;
	}
	h3 {
		color: var(--color-ink);
		font-size: 1.5rem;
		font-weight: 650;
		line-height: 1.2;
		letter-spacing: -0.021875rem;
	}
	p {
		margin-top: 0.75rem;
		color: var(--color-text);
		font-size: 1rem;
		line-height: 1.55;
	}
	@media (min-width: 48em) and (max-width: 68.75em) {
		.editorial-card__copy {
			padding: 1.375rem 1.25rem 1.625rem;
		}
		h3 {
			font-size: 1.3125rem;
		}
	}
	@media (max-width: 47.9375em) {
		img {
			aspect-ratio: 16 / 9;
		}
		.editorial-card__copy {
			padding: 1.5rem;
		}
		h3 {
			font-size: 1.4375rem;
		}
	}
</style>
