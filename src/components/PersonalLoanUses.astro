---
import EditorialCard from './EditorialCard.astro';
import homeImage from '../assets/editorial/hogar.jpg';
import studiesImage from '../assets/editorial/estudios.jpg';
import projectImage from '../assets/editorial/proyecto.jpg';

const uses = [
	{
		title: 'Tu hogar',
		description: 'Mejoras y adecuaciones para tu casa.',
		image: homeImage,
		alt: 'Una pareja eligiendo acabados durante una mejora de su hogar',
	},
	{
		title: 'Tus estudios',
		description: 'Un siguiente paso en tu formación.',
		image: studiesImage,
		alt: 'Una mujer estudiando y tomando apuntes en casa',
	},
	{
		title: 'Tu proyecto',
		description: 'Para gastos de salud y otros proyectos personales.',
		image: projectImage,
		alt: 'Una mujer trabajando en un proyecto personal de cerámica',
	},
];
---

<section class="personal-loan-uses" aria-labelledby="personal-loan-uses-title">
	<div class="personal-loan-uses__inner">
		<header class="personal-loan-uses__heading" data-page-reveal>
			<h2 id="personal-loan-uses-title">Impulsa tus <span>planes</span></h2>
			<p>Financiamiento para tus proyectos personales.</p>
		</header>
		<ul class="personal-loan-uses__grid" role="list" data-page-reveal-group>
			{uses.map((use) => <EditorialCard {...use} as="li" />)}
		</ul>
	</div>
</section>

<style>
	.personal-loan-uses {
		padding-bottom: 96px;
	}
	.personal-loan-uses__inner {
		width: min(calc(100% - 96px), 1276px);
		margin-inline: auto;
	}
	.personal-loan-uses__heading {
		text-align: center;
	}
	h2 {
		color: var(--color-ink);
		font-size: 44px;
		font-weight: 700;
		line-height: 1.1;
		letter-spacing: -0.8px;
	}
	h2 span {
		color: var(--color-primary);
	}
	.personal-loan-uses__heading p {
		margin-top: 14px;
		color: var(--color-text);
		font-size: 20px;
		line-height: 1.5;
	}
	.personal-loan-uses__grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 24px;
		margin: 44px 0 0;
		padding: 0;
		list-style: none;
	}
	@media (max-width: 1023px) {
		.personal-loan-uses__grid {
			gap: 20px;
		}
	}
	@media (max-width: 767px) {
		.personal-loan-uses {
			padding-bottom: 64px;
		}
		.personal-loan-uses__inner {
			width: calc(100% - 40px);
		}
		h2 {
			font-size: 38px;
			letter-spacing: -0.6px;
		}
		.personal-loan-uses__heading p {
			font-size: 17px;
		}
		.personal-loan-uses__grid {
			grid-template-columns: 1fr;
			gap: 20px;
			margin-top: 32px;
		}
	}
</style>
