---
import EditorialCard from "./EditorialCard.astro";
import fleetsImage from "../assets/editorial/vehiculos.jpg";
import medicalImage from "../assets/editorial/medico.jpg";
import machineryImage from "../assets/editorial/maquinaria.jpg";
import technologyImage from "../assets/editorial/tecnologia.jpg";

interface Props {
	product?: "lease" | "finance-lease";
}
const { product = "lease" } = Astro.props;
const financial = product === "finance-lease";

const assets = [
	{
		title: "Flotas vehiculares",
		description:
			"Autos ejecutivos, utilitarios y vehículos de carga ligera.",
		image: fleetsImage,
		alt: "Vehículos de reparto durante la carga de pedidos",
	},
	{
		title: "Equipo médico",
		description:
			"Resonadores, equipo de diagnóstico y mobiliario clínico especializado.",
		image: medicalImage,
		alt: "Una profesional preparando equipo de diagnóstico en una clínica",
	},
	{
		title: "Maquinaria pesada",
		description:
			"Equipamiento para construcción, minería, agricultura y manufactura.",
		image: machineryImage,
		alt: "Una excavadora en una obra de construcción",
	},
	{
		title: "Tecnología",
		description:
			"Servidores, redes, equipo de cómputo y sistemas de comunicación avanzados.",
		image: technologyImage,
		alt: "Un técnico revisando los servidores de un negocio",
	},
];
---

<section class="lease-assets" aria-labelledby="lease-assets-title">
	<header class="lease-section-heading" data-page-reveal>
		<h2 id="lease-assets-title">
			<span>Activos</span> para tu Operación
		</h2>
		<p>
			{
				financial
					? "Ejemplos de uso de equipo y vehículos que puedes evaluar mediante arrendamiento financiero, con alternativas al finalizar el contrato."
					: "Ejemplos de uso de activos que puedes evaluar mediante arrendamiento puro, priorizando su utilización y renovación."
			}{" "}
			La elegibilidad depende del bien y del análisis de la operación.
		</p>
	</header>

	<div class="lease-assets__grid" data-page-reveal-group>
		{
			assets.map((asset) => (
				<EditorialCard
					{...asset}
					variant="white"
					sizes="(max-width: 47.9375em) calc(100vw - 2.5rem), (max-width: 74.9375em) calc((100vw - 7.25rem) / 2), (max-width: 85.75em) calc((100vw - 10.5rem) / 4), 18.8125rem"
				/>
			))
		}
	</div>
</section>
