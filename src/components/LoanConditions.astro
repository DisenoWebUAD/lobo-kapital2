---
import { credits } from "../data/credits";

interface Props {
	product: keyof typeof credits;
}
const { product: productId } = Astro.props;
const product = credits[productId];
const titleId = `${productId}-loan-conditions-title`;
---

<div
	class="loan-conditions"
	aria-labelledby={titleId}
	data-page-reveal="fade"
>
	<h3 id={titleId}>Montos y condiciones</h3>

	<table aria-labelledby={titleId}>
		<tbody>
			<tr
				><th scope="row">Monto (MXN)</th><td
					class="loan-conditions__amount"
					>{product.amount}</td
				></tr
			>
			<tr>
				<th scope="row">Plazo</th>
				<td>{product.termRange}</td>
			</tr>
			<tr><th scope="row">Cobertura</th><td>{product.coverage}</td></tr>
			<tr
				><th scope="row">Tasa de interés</th><td
					class="loan-conditions__pending"
					>{product.contractualPricing.status}</td
				></tr
			>
			<tr
				><th scope="row">Comisión de apertura</th><td
					class="loan-conditions__pending"
					>{product.contractualPricing.status}</td
				></tr
			>
			<tr>
				<th scope="row">CAT informativo</th>
				<td
					>{product.cat} anual (sin IVA)<small
						>{product.catModality}</small
					></td
				>
			</tr>
		</tbody>
	</table>

	<footer class="loan-conditions__footnote">
		<p>{product.catDisclosure}</p>
	</footer>
</div>

<style>
	.loan-conditions {
		min-width: 0;
		padding: 2rem;
		border-radius: 1rem;
		background: var(--color-surface);
	}

	h3 {
		font-size: 2rem;
		font-weight: 700;
		line-height: 1.2;
		letter-spacing: -0.0375rem;
		color: #000;
	}

	table {
		width: 100%;
		margin-top: 1.5rem;
		border-collapse: collapse;
		table-layout: fixed;
		font-size: 1rem;
		line-height: 1.5;
	}

	th,
	td {
		padding-block: 1rem;
		border-bottom: 1px solid #e0e0de;
		text-align: left;
		vertical-align: baseline;
		overflow-wrap: break-word;
	}

	th {
		width: 43%;
		padding-right: 1.5rem;
		font-size: 0.875rem;
		font-weight: 400;
		color: #696967;
	}

	td {
		font-weight: 500;
		font-variant-numeric: tabular-nums;
	}

	.loan-conditions__amount {
		font-size: 1.375rem;
		font-weight: 600;
		letter-spacing: -0.01875rem;
	}

	.loan-conditions__pending {
		font-size: 0.875rem;
		font-weight: 400;
		color: #696967;
	}

	td small {
		display: block;
		margin-top: 0.375rem;
		font-size: 0.875rem;
		font-weight: 400;
		color: #696967;
	}

	.loan-conditions__footnote {
		margin-top: 1.5rem;
		font-size: 0.8125rem;
		line-height: 1.65;
		color: #696967;
	}

	@media (max-width: 47.9375em) {
		.loan-conditions {
			padding: 1.5rem;
		}

		h3 {
			font-size: 1.75rem;
		}

		.loan-conditions__amount {
			font-size: 1.125rem;
		}

		th {
			padding-right: 1rem;
		}
	}
</style>
