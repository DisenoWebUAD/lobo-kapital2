---
import heroImage from '../assets/pymes/hero.jpg';
---

<section class="pymes-hero" id="inicio" aria-labelledby="pymes-hero-title">
	<div class="pymes-hero__copy">
		<h1 id="pymes-hero-title">Financiamiento <span>Estratégico</span> para tu Empresa</h1>
		<p>Impulsa el crecimiento de tu negocio con soluciones de crédito diseñadas para las<br class="pymes-desktop-break" /> necesidades específicas de la pequeña y mediana empresa en México.</p>
		<a class="button button--primary" href="#solicitud">Hablar con un Asesor</a>
	</div>

	<svg class="pymes-hero__media" viewBox="0 0 1920 532.39" role="img" aria-label="Emprendedora en su negocio">
		<defs>
			<clipPath id="pymes-hero-clip">
				<path d="M280.16 0H1639.84C1794.57 0 1920 125.43 1920 280.16V532.39H0V280.16C0 125.43 125.43 0 280.16 0Z" />
			</clipPath>
		</defs>
		<image href={heroImage.src} x="0" y="-166.73" width="1922.99" height="1282" preserveAspectRatio="none" clip-path="url(#pymes-hero-clip)" />
	</svg>
</section>
