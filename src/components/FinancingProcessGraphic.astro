---
interface Props {
	product: 'revolving' | 'finance-lease';
	stage: number;
}

const { product, stage } = Astro.props;
---

<svg class="financing-process-graphic" viewBox="0 0 200 144" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
	{product === 'revolving' && stage === 0 && (
		<>
			<path d="m28 62 41-21 41 21-41 22zM28 62v48l41 22 41-22V62M69 84v48M48 52l41 22v18" />
			<path d="m100 33 35-18 36 18-36 19zM110 47l25 13 36-19M135 52v42l36-19V33M100 33v16" />
			<path class="financing-process-graphic__accent" d="m118 24 35 19v14" />
			<path d="M120 111h52m-14-13 14 13-14 13" />
		</>
	)}
	{product === 'revolving' && stage === 1 && (
		<>
			<rect x="43" y="44" width="116" height="79" rx="10" />
			<path d="M43 64h116M60 82h25m-25 13h14M62 44V29l78-11 4 26" />
			<path class="financing-process-graphic__accent" d="M104 82h55v26h-55a13 13 0 0 1 0-26Z" />
			<circle cx="116" cy="95" r="3" />
			<path d="M27 98H14m6-6-6 6 6 6M173 54h13m-6-6 6 6-6 6" />
		</>
	)}
	{product === 'revolving' && stage === 2 && (
		<>
			<path d="M40 65a62 62 0 0 1 107-35l12 13m-1-24 1 24-24-1M160 82A62 62 0 0 1 53 114l-12-13m1 24-1-24 24 1" />
			<rect x="65" y="50" width="70" height="45" rx="5" />
			<path d="M77 50a12 12 0 0 1-12 12m0 21a12 12 0 0 1 12 12m46 0a12 12 0 0 1 12-12m0-21a12 12 0 0 1-12-12" />
			<circle class="financing-process-graphic__accent" cx="100" cy="72.5" r="11" />
		</>
	)}
	{product === 'finance-lease' && stage === 0 && (
		<>
			<path d="M25 108V51a8 8 0 0 1 8-8h85l31 13 23 28v24h-15m-28 0H69m-28 0H25M118 43v65M128 57h18l18 25h-36z" />
			<circle cx="55" cy="108" r="14" />
			<circle cx="143" cy="108" r="14" />
			<path d="M134 91h7M25 88h10m129 0h8M42 57h57v24H42z" />
			<path class="financing-process-graphic__accent" d="M42 91h57" />
		</>
	)}
	{product === 'finance-lease' && stage === 1 && (
		<>
			<rect x="43" y="30" width="114" height="99" rx="8" />
			<path d="M43 58h114M70 20v22m60-22v22M63 76h12m19 0h12m19 0h12M63 95h12m19 0h12M63 114h12m19 0h12m19 0h12" />
			<path class="financing-process-graphic__accent" d="m122 93 7 7 14-16" />
		</>
	)}
	{product === 'finance-lease' && stage === 2 && (
		<>
			<path d="M28 35h43l17 18v57H28zM71 35v18h17M40 69h35m-35 14h26M40 97h17" />
			<path d="M88 73h28m0 0V29h48m-48 44h48m-48 0v44h48M156 21l8 8-8 8m0 28 8 8-8 8m0 28 8 8-8 8" />
			<circle class="financing-process-graphic__accent" cx="116" cy="73" r="5" />
		</>
	)}
</svg>

<style>
	.financing-process-graphic {
		display: block;
		width: 100%;
		height: auto;
		color: var(--color-soft);
	}
	.financing-process-graphic :is(path, rect, circle) { vector-effect: non-scaling-stroke; }
	.financing-process-graphic__accent { stroke: var(--color-process-accent); }
</style>
