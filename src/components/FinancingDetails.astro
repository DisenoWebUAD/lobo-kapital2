---
import { financingProducts, type FinancingProductId } from '../data/financing-products';

interface Props { product: FinancingProductId }
const { product: productId } = Astro.props;
const product = financingProducts[productId];
---

<section class="financing-details" id="condiciones" aria-labelledby="financing-details-title">
	<div class="financing-container financing-details__grid" data-page-reveal-group>
		<div class="financing-requirements" id="requisitos" data-page-reveal>
			<h2 id="financing-details-title">¿Puede ser para <span>tu empresa?</span></h2>
			<p>{product.intro}</p>
			<ul>{product.requirements.map((requirement) => <li><svg viewBox="0 0 24 24" width="18" height="18" fill="none" aria-hidden="true"><path d="m5 12 4 4L19 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>{requirement}</li>)}</ul>
			<p class="financing-small">No adjuntes documentos ni facturas al pedir información. Si decides iniciar el trámite, un asesor te indicará el canal correspondiente.</p>
		</div>
		<div class="financing-conditions" aria-labelledby="financing-conditions-title" data-page-reveal="fade">
			<h3 id="financing-conditions-title">Condiciones del producto</h3>
			<ul class="financing-conditions__list">
				{product.conditions.map((condition) => <li>{condition}</li>)}
			</ul>
			{product.referenceFacts.length > 0 && (
				<dl class="financing-conditions__references">
					{product.referenceFacts.map((fact) => <div><dt>{fact.label}</dt><dd>{fact.value}</dd></div>)}
				</dl>
			)}
			<p class="financing-conditions__note">{product.contractNote}</p>
			{productId === 'lease' ? (
				<p class="financing-cat financing-cat--static">{product.cat}</p>
			) : (
				<details class="financing-cat">
					<summary>CAT informativo {product.cat}<small>{product.catModality}</small></summary>
					{productId === 'factoring' ? (
						<div class="financing-cat__modalities">
							<section aria-labelledby="factoring-cat-with-recourse">
								<h4 id="factoring-cat-with-recourse">Con recurso</h4>
								<p>{financingProducts.factoring.catDisclosures.withRecourse}</p>
							</section>
							<section aria-labelledby="factoring-cat-without-recourse">
								<h4 id="factoring-cat-without-recourse">Sin recurso con cobranza directa</h4>
								<p>{financingProducts.factoring.catDisclosures.withoutRecourse}</p>
							</section>
						</div>
					) : <p>{product.catDisclosure}</p>}
				</details>
			)}
		</div>
	</div>
</section>
